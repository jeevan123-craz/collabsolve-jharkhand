    instruction: "Update admin dashboard to show dynamic challenges from Firestore grouped by status, with a dropdown to update their status."
    replacement_infos {
      original_chunk {
        target_content: "\'use client\';\n\nimport Link from \'next/link\';\nimport { motion } from \'motion/react\';\nimport { ClipboardList, Briefcase, CheckCircle, MoreVertical, MapPin, Bot, Users } from \'lucide-react\';\n\nexport default function Page() {\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    visible: { opacity: 1, transition: { staggerChildren: 0.1 } }\n  };\n\n  const itemVariants = {\n    hidden: { y: 20, opacity: 0 },\n    visible: { y: 0, opacity: 1 }\n  };\n\n  return (\n    <div className=\"pt-8 px-gutter max-w-container-max mx-auto pb-xl flex flex-col h-[calc(100vh-64px)] overflow-hidden gap-md\">\n      \n      {/* Header & Analytics */}\n      <motion.section initial=\"hidden\" animate=\"visible\" variants={containerVariants} className=\"flex flex-col gap-md flex-shrink-0\">\n        <motion.h1 variants={itemVariants} className=\"font-headline-lg text-headline-lg text-on-surface\">Admin Kanban Board</motion.h1>\n        <motion.div variants={itemVariants} className=\"grid grid-cols-1 sm:grid-cols-3 gap-md\">\n          {/* Analytics Card 1 */}\n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all\">\n            <div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-sm\">\n              <ClipboardList className=\"w-5 h-5 text-primary\" />\n              <span>Total Challenges</span>\n            </div>\n            <div className=\"font-headline-lg text-4xl font-bold text-on-surface mt-2\">1,240</div>\n          </div>\n          {/* Analytics Card 2 */}\n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all\">\n            <div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-sm\">\n              <Briefcase className=\"w-5 h-5 text-secondary\" />\n              <span>Active Projects</span>\n            </div>\n            <div className=\"font-headline-lg text-4xl font-bold text-on-surface mt-2\">84</div>\n          </div>\n          {/* Analytics Card 3 */}\n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all\">\n            <div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-sm\">\n              <CheckCircle className=\"w-5 h-5 text-success-green\" />\n              <span>Success Rate</span>\n            </div>\n            <div className=\"font-headline-lg text-4xl font-bold text-success-green mt-2\">92%</div>\n          </div>\n        </motion.div>\n      </motion.section>\n      \n      {/* Kanban Board */}\n      <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }} className=\"flex-grow flex gap-md overflow-x-auto custom-scrollbar pb-md\">\n        {/* Column 1: Reported */}\n        <div className=\"flex-shrink-0 w-80 flex flex-col gap-sm bg-surface-container-low rounded-2xl p-md border border-surface-variant h-full\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-outline-variant/30\">\n            <h2 className=\"font-label-md text-sm font-bold text-on-surface uppercase tracking-wider\">Reported</h2>\n            <span className=\"bg-surface-variant/50 text-on-surface-variant rounded-full px-2.5 py-0.5 text-xs font-bold\">3</span>\n          </div>\n          <div className=\"flex flex-col gap-sm overflow-y-auto custom-scrollbar h-full pr-2 pt-2\">\n            {/* Card */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-all group\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"bg-error-container text-on-error-container text-[10px] font-bold px-2 py-1 rounded-md tracking-wider\">HIGH URGENCY</span>\n                <button className=\"text-outline hover:text-primary transition-colors\"><MoreVertical className=\"w-4 h-4\" /></button>\n              </div>\n              <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 group-hover:text-primary transition-colors\">Rural Electrification in Simdega</h3>\n              <div className=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-sm mt-1\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Simdega</span>\n              </div>\n              <div className=\"mt-3 pt-3 border-t border-outline-variant/30 flex items-center gap-2 bg-primary/5 -mx-4 -mb-4 px-4 py-3 rounded-b-xl\">\n                <Bot className=\"w-4 h-4 text-primary\" />\n                <span className=\"font-label-sm text-xs font-bold text-primary\">Matches: IIT ISM Dhanbad</span>\n              </div>\n            </motion.div>\n            {/* Card */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-all group\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"bg-surface-variant/50 text-on-surface-variant text-[10px] font-bold px-2 py-1 rounded-md tracking-wider\">LOW URGENCY</span>\n                <button className=\"text-outline hover:text-primary transition-colors\"><MoreVertical className=\"w-4 h-4\" /></button>\n              </div>\n              <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 group-hover:text-primary transition-colors\">Water Quality Monitoring</h3>\n              <div className=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-sm mt-1\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Dhanbad</span>\n              </div>\n              <div className=\"mt-3 pt-3 border-t border-outline-variant/30 flex items-center gap-2 bg-primary/5 -mx-4 -mb-4 px-4 py-3 rounded-b-xl\">\n                <Bot className=\"w-4 h-4 text-primary\" />\n                <span className=\"font-label-sm text-xs font-bold text-primary\">Matches: BIT Sindri</span>\n              </div>\n            </motion.div>\n          </div>\n        </div>\n        \n        {/* Column 2: Validated */}\n        <div className=\"flex-shrink-0 w-80 flex flex-col gap-sm bg-surface-container-low rounded-2xl p-md border border-surface-variant h-full\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-outline-variant/30\">\n            <h2 className=\"font-label-md text-sm font-bold text-on-surface uppercase tracking-wider\">Validated</h2>\n            <span className=\"bg-surface-variant/50 text-on-surface-variant rounded-full px-2.5 py-0.5 text-xs font-bold\">2</span>\n          </div>\n          <div className=\"flex flex-col gap-sm overflow-y-auto custom-scrollbar h-full pr-2 pt-2\">\n            {/* Card */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-all group\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"bg-warning-amber/10 text-warning-amber text-[10px] font-bold px-2 py-1 rounded-md tracking-wider\">MEDIUM URGENCY</span>\n                <button className=\"text-outline hover:text-primary transition-colors\"><MoreVertical className=\"w-4 h-4\" /></button>\n              </div>\n              <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 group-hover:text-primary transition-colors\">Waste Management Tech</h3>\n              <div className=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-sm mt-1\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Ranchi</span>\n              </div>\n              <div className=\"mt-3 pt-3 border-t border-outline-variant/30 flex items-center gap-2 bg-primary/5 -mx-4 -mb-4 px-4 py-3 rounded-b-xl\">\n                <Bot className=\"w-4 h-4 text-primary\" />\n                <span className=\"font-label-sm text-xs font-bold text-primary\">Matches: BIT Mesra</span>\n              </div>\n            </motion.div>\n            {/* Card */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-all group\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"bg-error-container text-on-error-container text-[10px] font-bold px-2 py-1 rounded-md tracking-wider\">HIGH URGENCY</span>\n                <button className=\"text-outline hover:text-primary transition-colors\"><MoreVertical className=\"w-4 h-4\" /></button>\n              </div>\n              <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 group-hover:text-primary transition-colors\">Forest Fire Detection Drone</h3>\n              <div className=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-sm mt-1\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Latehar</span>\n              </div>\n              <div className=\"mt-3 pt-3 border-t border-outline-variant/30 flex items-center gap-2 bg-primary/5 -mx-4 -mb-4 px-4 py-3 rounded-b-xl\">\n                <Bot className=\"w-4 h-4 text-primary\" />\n                <span className=\"font-label-sm text-xs font-bold text-primary\">Matches: NIT Jamshedpur</span>\n              </div>\n            </motion.div>\n          </div>\n        </div>\n        \n        {/* Column 3: Open for Proposals */}\n        <div className=\"flex-shrink-0 w-80 flex flex-col gap-sm bg-surface-container-low rounded-2xl p-md border border-surface-variant h-full\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-outline-variant/30\">\n            <h2 className=\"font-label-md text-sm font-bold text-on-surface uppercase tracking-wider\">Open for Proposals</h2>\n            <span className=\"bg-surface-variant/50 text-on-surface-variant rounded-full px-2.5 py-0.5 text-xs font-bold\">2</span>\n          </div>\n          <div className=\"flex flex-col gap-sm overflow-y-auto custom-scrollbar h-full pr-2 pt-2\">\n            {/* Card */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-all group\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"bg-warning-amber/10 text-warning-amber text-[10px] font-bold px-2 py-1 rounded-md tracking-wider\">MEDIUM URGENCY</span>\n                <button className=\"text-outline hover:text-primary transition-colors\"><MoreVertical className=\"w-4 h-4\" /></button>\n              </div>\n              <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 group-hover:text-primary transition-colors\">Smart Irrigation Systems</h3>\n              <div className=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-sm mt-1\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Hazaribagh</span>\n              </div>\n              <div className=\"mt-3 pt-3 border-t border-outline-variant/30 flex items-center gap-2 bg-primary/5 -mx-4 -mb-4 px-4 py-3 rounded-b-xl\">\n                <Bot className=\"w-4 h-4 text-primary\" />\n                <span className=\"font-label-sm text-xs font-bold text-primary\">Matches: BAU Ranchi</span>\n              </div>\n            </motion.div>\n            {/* Card */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-all group\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"bg-surface-variant/50 text-on-surface-variant text-[10px] font-bold px-2 py-1 rounded-md tracking-wider\">LOW URGENCY</span>\n                <button className=\"text-outline hover:text-primary transition-colors\"><MoreVertical className=\"w-4 h-4\" /></button>\n              </div>\n              <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 group-hover:text-primary transition-colors\">Traffic Management App</h3>\n              <div className=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-sm mt-1\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Bokaro</span>\n              </div>\n              <div className=\"mt-3 pt-3 border-t border-outline-variant/30 flex items-center gap-2 bg-primary/5 -mx-4 -mb-4 px-4 py-3 rounded-b-xl\">\n                <Bot className=\"w-4 h-4 text-primary\" />\n                <span className=\"font-label-sm text-xs font-bold text-primary\">Matches: IIT ISM Dhanbad</span>\n              </div>\n            </motion.div>\n          </div>\n        </div>\n        \n        {/* Column 4: In Progress */}\n        <div className=\"flex-shrink-0 w-80 flex flex-col gap-sm bg-surface-container-low rounded-2xl p-md border border-surface-variant h-full\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-outline-variant/30\">\n            <h2 className=\"font-label-md text-sm font-bold text-on-surface uppercase tracking-wider\">In Progress</h2>\n            <span className=\"bg-surface-variant/50 text-on-surface-variant rounded-full px-2.5 py-0.5 text-xs font-bold\">1</span>\n          </div>\n          <div className=\"flex flex-col gap-sm overflow-y-auto custom-scrollbar h-full pr-2 pt-2\">\n            {/* Card */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-all group border-l-4 border-l-success-green relative overflow-hidden\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"bg-error-container text-on-error-container text-[10px] font-bold px-2 py-1 rounded-md tracking-wider\">HIGH URGENCY</span>\n                <button className=\"text-outline hover:text-primary transition-colors\"><MoreVertical className=\"w-4 h-4\" /></button>\n              </div>\n              <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 group-hover:text-primary transition-colors\">Maternal Health Dashboard</h3>\n              <div className=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-sm mt-1\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Godda</span>\n              </div>\n              <div className=\"mt-3 pt-3 border-t border-outline-variant/30 flex items-center gap-2 bg-[#DCFCE7]/30 -mx-4 -mb-4 px-4 py-3 rounded-b-xl\">\n                <div className=\"flex -space-x-2\">\n                  <div className=\"w-7 h-7 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold ring-2 ring-surface-container-lowest shadow-sm z-10\">B</div>\n                  <div className=\"w-7 h-7 rounded-full bg-secondary flex items-center justify-center text-white text-xs font-bold ring-2 ring-surface-container-lowest shadow-sm z-0\">I</div>\n                </div>\n                <span className=\"font-label-sm text-xs font-bold text-success-green ml-2 flex items-center gap-1\"><Users className=\"w-3.5 h-3.5\" /> Active: BIT Mesra Team</span>\n              </div>\n            </motion.div>\n          </div>\n        </div>\n      </motion.section>\n    </div>\n  );\n}\n"
        replacement_content: "\'use client\';\n\nimport { useState, useEffect } from \'react\';\nimport { motion } from \'motion/react\';\nimport { ClipboardList, Briefcase, CheckCircle, MapPin, Bot, Users, Edit } from \'lucide-react\';\nimport { db } from \'@/lib/firebase\';\nimport { collection, query, onSnapshot, doc, updateDoc } from \'firebase/firestore\';\nimport { useApp } from \'@/lib/AppContext\';\nimport Link from \'next/link\';\n\nconst columns = [\'Reported\', \'Validated\', \'Open for Proposals\', \'In Progress\', \'Resolved\'];\n\nexport default function Page() {\n  const { user } = useApp();\n  const [challenges, setChallenges] = useState<any[]>([]);\n\n  useEffect(() => {\n    const q = query(collection(db, \'challenges\'));\n    const unsubscribe = onSnapshot(q, (snapshot) => {\n      setChallenges(snapshot.docs.map(d => ({ id: d.id, ...d.data() })));\n    });\n    return () => unsubscribe();\n  }, []);\n\n  const updateStatus = async (id: string, newStatus: string) => {\n    try {\n      await updateDoc(doc(db, \'challenges\', id), { status: newStatus });\n    } catch (e) {\n      console.error(e);\n      alert(\'Failed to update status\');\n    }\n  };\n\n  const getUrgencyColor = (urgency: string) => {\n    if (urgency === \'Critical\') return \'bg-[#991B1B]/10 text-[#991B1B]\';\n    if (urgency === \'High\') return \'bg-error-container text-on-error-container\';\n    if (urgency === \'Medium\') return \'bg-warning-amber/10 text-warning-amber\';\n    return \'bg-surface-variant/50 text-on-surface-variant\';\n  };\n\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    visible: { opacity: 1, transition: { staggerChildren: 0.1 } }\n  };\n\n  const itemVariants = {\n    hidden: { y: 20, opacity: 0 },\n    visible: { y: 0, opacity: 1 }\n  };\n\n  return (\n    <div className=\"pt-8 px-gutter max-w-container-max mx-auto pb-xl flex flex-col h-[calc(100vh-64px)] overflow-hidden gap-md\">\n      \n      {/* Header & Analytics */}\n      <motion.section initial=\"hidden\" animate=\"visible\" variants={containerVariants} className=\"flex flex-col gap-md flex-shrink-0\">\n        <motion.h1 variants={itemVariants} className=\"font-headline-lg text-headline-lg text-on-surface\">Admin Kanban Board</motion.h1>\n        <motion.div variants={itemVariants} className=\"grid grid-cols-1 sm:grid-cols-3 gap-md\">\n          {/* Analytics Card 1 */}\n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all\">\n            <div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-sm\">\n              <ClipboardList className=\"w-5 h-5 text-primary\" />\n              <span>Total Challenges</span>\n            </div>\n            <div className=\"font-headline-lg text-4xl font-bold text-on-surface mt-2\">{challenges.length}</div>\n          </div>\n          {/* Analytics Card 2 */}\n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all\">\n            <div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-sm\">\n              <Briefcase className=\"w-5 h-5 text-secondary\" />\n              <span>Open for Proposals</span>\n            </div>\n            <div className=\"font-headline-lg text-4xl font-bold text-on-surface mt-2\">{challenges.filter(c => c.status === \'Open for Proposals\').length}</div>\n          </div>\n          {/* Analytics Card 3 */}\n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all\">\n            <div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-sm\">\n              <CheckCircle className=\"w-5 h-5 text-success-green\" />\n              <span>Resolved</span>\n            </div>\n            <div className=\"font-headline-lg text-4xl font-bold text-success-green mt-2\">{challenges.filter(c => c.status === \'Resolved\').length}</div>\n          </div>\n        </motion.div>\n      </motion.section>\n      \n      {/* Kanban Board */}\n      <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }} className=\"flex-grow flex gap-md overflow-x-auto custom-scrollbar pb-md\">\n        {columns.map(col => {\n          const colChallenges = challenges.filter(c => (c.status || \'Reported\') === col);\n          return (\n            <div key={col} className=\"flex-shrink-0 w-80 flex flex-col gap-sm bg-surface-container-low rounded-2xl p-md border border-surface-variant h-full\">\n              <div className=\"flex items-center justify-between pb-3 border-b border-outline-variant/30\">\n                <h2 className=\"font-label-md text-sm font-bold text-on-surface uppercase tracking-wider\">{col}</h2>\n                <span className=\"bg-surface-variant/50 text-on-surface-variant rounded-full px-2.5 py-0.5 text-xs font-bold\">{colChallenges.length}</span>\n              </div>\n              <div className=\"flex flex-col gap-sm overflow-y-auto custom-scrollbar h-full pr-2 pt-2\">\n                {colChallenges.map(challenge => (\n                  <motion.div key={challenge.id} whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all group relative\">\n                    <div className=\"flex justify-between items-start\">\n                      <span className={`${getUrgencyColor(challenge.urgency || \'Medium\')} text-[10px] font-bold px-2 py-1 rounded-md tracking-wider uppercase`}>\n                        {challenge.urgency || \'Medium\'} URGENCY\n                      </span>\n                      <select \n                        value={challenge.status || \'Reported\'}\n                        onChange={(e) => updateStatus(challenge.id, e.target.value)}\n                        className=\"text-xs bg-surface-container-low border border-outline-variant rounded p-1 outline-none font-bold text-primary cursor-pointer hover:bg-surface-variant/30\"\n                      >\n                        {columns.map(c => <option key={c} value={c}>{c}</option>)}\n                      </select>\n                    </div>\n                    <Link href={`/challenges/${challenge.id}`}>\n                      <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 hover:text-primary transition-colors cursor-pointer\">{challenge.title}</h3>\n                    </Link>\n                    <div className=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-sm mt-1\">\n                      <MapPin className=\"w-3.5 h-3.5\" />\n                      <span>{challenge.district}</span>\n                    </div>\n                    {challenge.aiCategories && challenge.aiCategories.length > 0 && (\n                      <div className=\"mt-3 pt-3 border-t border-outline-variant/30 flex items-center gap-2 bg-primary/5 -mx-4 -mb-4 px-4 py-3 rounded-b-xl\">\n                        <Bot className=\"w-4 h-4 text-primary\" />\n                        <span className=\"font-label-sm text-xs font-bold text-primary line-clamp-1\" title={challenge.aiCategories.join(\', \')}>\n                          Matches: {challenge.aiCategories[0]}\n                        </span>\n                      </div>\n                    )}\n                  </motion.div>\n                ))}\n              </div>\n            </div>\n          );\n        })}\n      </motion.section>\n    </div>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
