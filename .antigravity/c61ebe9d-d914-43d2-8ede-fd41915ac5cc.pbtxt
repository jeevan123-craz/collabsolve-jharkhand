    instruction: "Add user login button, user avatar, and logout logic. Hide the role dropdown unless they are logged in (or just keep it so they can set their role even when testing)."
    replacement_infos {
      original_chunk {
        target_content: "\'use client\';\nimport Link from \'next/link\';\nimport { useApp } from \'@/lib/AppContext\';\n\nexport default function Navbar() {\n  const { role, setRole, lang, setLang, t } = useApp();\n  \n  const toggleLanguage = () => setLang(lang === \'en\' ? \'hi\' : \'en\');\n\n  const handleRoleChange = (e: React.ChangeEvent<HTMLSelectElement>) => {\n    setRole(e.target.value as any);\n  };\n\n  const roleLinks = {\n    citizen: [\n      { href: \'/citizen\', label: t(\'navCitizen\') },\n      { href: \'/challenges\', label: t(\'navChallenges\') },\n    ],\n    admin: [\n      { href: \'/admin\', label: t(\'navAdmin\') },\n      { href: \'/challenges\', label: t(\'navChallenges\') },\n    ],\n    researcher: [\n      { href: \'/researcher\', label: t(\'navResearcher\') },\n      { href: \'/challenges\', label: t(\'navChallenges\') },\n    ],\n    industry: [\n      { href: \'/industry\', label: t(\'navIndustry\') },\n      { href: \'/challenges\', label: t(\'navChallenges\') },\n    ]\n  };\n\n  const links = roleLinks[role];\n\n  return (\n    <nav className=\"bg-surface-container-lowest dark:bg-surface-dark fixed top-0 w-full z-50 shadow-sm dark:border-b dark:border-outline-variant\">\n      <div className=\"flex justify-between items-center h-16 px-gutter max-w-container-max mx-auto\">\n        <Link href=\"/\" className=\"font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed cursor-pointer hover:opacity-80 transition-opacity active:scale-95 duration-200\">\n          CollabSolve Jharkhand\n        </Link>\n        <div className=\"hidden md:flex space-x-8 font-label-md text-label-md items-center\">\n          {links.map(link => (\n            <Link key={link.href} href={link.href} className=\"text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed cursor-pointer hover:opacity-80 transition-opacity active:scale-95 duration-200\">\n              {link.label}\n            </Link>\n          ))}\n          \n          {/* Controls */}\n          <div className=\"flex items-center space-x-4 border-l border-outline-variant pl-4\">\n            <button onClick={toggleLanguage} className=\"flex items-center text-on-surface-variant hover:text-primary transition-colors\" title=\"Toggle Language\">\n              <span className=\"material-symbols-outlined mr-1\" style={{fontVariationSettings: \"\'FILL\' 1\"}}>language</span>\n              {lang === \'en\' ? \'HI\' : \'EN\'}\n            </button>\n            <select \n              value={role} \n              onChange={handleRoleChange}\n              className=\"bg-surface-container-low border border-outline-variant text-on-surface text-sm rounded-md focus:ring-primary focus:border-primary block p-2\"\n            >\n              <option value=\"citizen\">\360\237\221\244 Citizen</option>\n              <option value=\"admin\">\360\237\233\241\357\270\217 Govt Admin</option>\n              <option value=\"researcher\">\360\237\216\223 Researcher</option>\n              <option value=\"industry\">\360\237\217\255 Industry</option>\n            </select>\n          </div>\n        </div>\n      </div>\n    </nav>\n  );\n}\n"
        replacement_content: "\'use client\';\nimport Link from \'next/link\';\nimport { useApp } from \'@/lib/AppContext\';\nimport { LogIn, LogOut, User as UserIcon } from \'lucide-react\';\n\nexport default function Navbar() {\n  const { role, setRole, lang, setLang, t, user, login, logout } = useApp();\n  \n  const toggleLanguage = () => setLang(lang === \'en\' ? \'hi\' : \'en\');\n\n  const handleRoleChange = (e: React.ChangeEvent<HTMLSelectElement>) => {\n    setRole(e.target.value as any);\n  };\n\n  const roleLinks = {\n    citizen: [\n      { href: \'/citizen\', label: t(\'navCitizen\') },\n      { href: \'/challenges\', label: t(\'navChallenges\') },\n    ],\n    admin: [\n      { href: \'/admin\', label: t(\'navAdmin\') },\n      { href: \'/challenges\', label: t(\'navChallenges\') },\n    ],\n    researcher: [\n      { href: \'/researcher\', label: t(\'navResearcher\') },\n      { href: \'/challenges\', label: t(\'navChallenges\') },\n    ],\n    industry: [\n      { href: \'/industry\', label: t(\'navIndustry\') },\n      { href: \'/challenges\', label: t(\'navChallenges\') },\n    ]\n  };\n\n  const links = roleLinks[role];\n\n  return (\n    <nav className=\"bg-surface-container-lowest dark:bg-surface-dark fixed top-0 w-full z-50 shadow-sm dark:border-b dark:border-outline-variant\">\n      <div className=\"flex justify-between items-center h-16 px-gutter max-w-container-max mx-auto\">\n        <Link href=\"/\" className=\"font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed cursor-pointer hover:opacity-80 transition-opacity active:scale-95 duration-200\">\n          CollabSolve Jharkhand\n        </Link>\n        <div className=\"hidden md:flex space-x-8 font-label-md text-label-md items-center\">\n          {links.map(link => (\n            <Link key={link.href} href={link.href} className=\"text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed cursor-pointer hover:opacity-80 transition-opacity active:scale-95 duration-200\">\n              {link.label}\n            </Link>\n          ))}\n          \n          {/* Controls */}\n          <div className=\"flex items-center space-x-4 border-l border-outline-variant pl-4\">\n            <button onClick={toggleLanguage} className=\"flex items-center text-on-surface-variant hover:text-primary transition-colors\" title=\"Toggle Language\">\n              <span className=\"material-symbols-outlined mr-1\" style={{fontVariationSettings: \"\'FILL\' 1\"}}>language</span>\n              {lang === \'en\' ? \'HI\' : \'EN\'}\n            </button>\n            <select \n              value={role} \n              onChange={handleRoleChange}\n              className=\"bg-surface-container-low border border-outline-variant text-on-surface text-sm rounded-md focus:ring-primary focus:border-primary block p-2\"\n            >\n              <option value=\"citizen\">\360\237\221\244 Citizen</option>\n              <option value=\"admin\">\360\237\233\241\357\270\217 Govt Admin</option>\n              <option value=\"researcher\">\360\237\216\223 Researcher</option>\n              <option value=\"industry\">\360\237\217\255 Industry</option>\n            </select>\n            {user ? (\n              <div className=\"flex items-center space-x-3 bg-surface-container-low px-3 py-1.5 rounded-full border border-surface-variant\">\n                {user.photoURL ? (\n                  <img src={user.photoURL} alt=\"Profile\" className=\"w-7 h-7 rounded-full\" />\n                ) : (\n                  <div className=\"w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center\">\n                    <UserIcon className=\"w-4 h-4\" />\n                  </div>\n                )}\n                <span className=\"text-sm font-medium text-on-surface max-w-[100px] truncate\">{user.displayName}</span>\n                <button onClick={logout} className=\"text-on-surface-variant hover:text-error transition-colors p-1\" title=\"Log Out\">\n                  <LogOut className=\"w-4 h-4\" />\n                </button>\n              </div>\n            ) : (\n              <button onClick={login} className=\"flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-full font-label-md font-bold hover:opacity-90 transition-opacity shadow-sm\">\n                <LogIn className=\"w-4 h-4\" />\n                Login\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n    </nav>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
