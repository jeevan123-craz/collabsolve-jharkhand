        replacement_content: "\'use client\';\n\nimport Link from \'next/link\';\nimport { motion } from \'motion/react\';\nimport { ClipboardList, Briefcase, CheckCircle, MoreVertical, MapPin, Bot, Users } from \'lucide-react\';\n\nexport default function Page() {\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    visible: { opacity: 1, transition: { staggerChildren: 0.1 } }\n  };\n\n  const itemVariants = {\n    hidden: { y: 20, opacity: 0 },\n    visible: { y: 0, opacity: 1 }\n  };\n\n  return (\n    <div className=\"pt-8 px-gutter max-w-container-max mx-auto pb-xl flex flex-col h-[calc(100vh-64px)] overflow-hidden gap-md\">\n      \n      {/* Header & Analytics */}\n      <motion.section initial=\"hidden\" animate=\"visible\" variants={containerVariants} className=\"flex flex-col gap-md flex-shrink-0\">\n        <motion.h1 variants={itemVariants} className=\"font-headline-lg text-headline-lg text-on-surface\">Admin Kanban Board</motion.h1>\n        <motion.div variants={itemVariants} className=\"grid grid-cols-1 sm:grid-cols-3 gap-md\">\n          {/* Analytics Card 1 */}\n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all\">\n            <div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-sm\">\n              <ClipboardList className=\"w-5 h-5 text-primary\" />\n              <span>Total Challenges</span>\n            </div>\n            <div className=\"font-headline-lg text-4xl font-bold text-on-surface mt-2\">1,240</div>\n          </div>\n          {/* Analytics Card 2 */}\n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all\">\n            <div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-sm\">\n              <Briefcase className=\"w-5 h-5 text-secondary\" />\n              <span>Active Projects</span>\n            </div>\n            <div className=\"font-headline-lg text-4xl font-bold text-on-surface mt-2\">84</div>\n          </div>\n          {/* Analytics Card 3 */}\n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant flex flex-col gap-xs hover:shadow-md transition-all\">\n            <div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-sm\">\n              <CheckCircle className=\"w-5 h-5 text-success-green\" />\n              <span>Success Rate</span>\n            </div>\n            <div className=\"font-headline-lg text-4xl font-bold text-success-green mt-2\">92%</div>\n          </div>\n        </motion.div>\n      </motion.section>\n      \n      {/* Kanban Board */}\n      <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }} className=\"flex-grow flex gap-md overflow-x-auto custom-scrollbar pb-md\">\n        {/* Column 1: Reported */}\n        <div className=\"flex-shrink-0 w-80 flex flex-col gap-sm bg-surface-container-low rounded-2xl p-md border border-surface-variant h-full\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-outline-variant/30\">\n            <h2 className=\"font-label-md text-sm font-bold text-on-surface uppercase tracking-wider\">Reported</h2>\n            <span className=\"bg-surface-variant/50 text-on-surface-variant rounded-full px-2.5 py-0.5 text-xs font-bold\">3</span>\n          </div>\n          <div className=\"flex flex-col gap-sm overflow-y-auto custom-scrollbar h-full pr-2 pt-2\">\n            {/* Card */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-all group\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"bg-error-container text-on-error-container text-[10px] font-bold px-2 py-1 rounded-md tracking-wider\">HIGH URGENCY</span>\n                <button className=\"text-outline hover:text-primary transition-colors\"><MoreVertical className=\"w-4 h-4\" /></button>\n              </div>\n              <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 group-hover:text-primary transition-colors\">Rural Electrification in Simdega</h3>\n              <div className=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-sm mt-1\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Simdega</span>\n              </div>\n              <div className=\"mt-3 pt-3 border-t border-outline-variant/30 flex items-center gap-2 bg-primary/5 -mx-4 -mb-4 px-4 py-3 rounded-b-xl\">\n                <Bot className=\"w-4 h-4 text-primary\" />\n                <span className=\"font-label-sm text-xs font-bold text-primary\">Matches: IIT ISM Dhanbad</span>\n              </div>\n            </motion.div>\n            {/* Card */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-xl shadow-sm border border-surface-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-all group\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"bg-surface-variant/50 text-on-surface-variant text-[10px] font-bold px-2 py-1 rounded-md tracking-wider\">LOW URGENCY</span>\n                <button className=\"text-outline hover:text-primary transition-colors\"><MoreVertical className=\"w-4 h-4\" /></button>\n              </div>\n              <h3 className=\"font-headline-md text-lg leading-tight font-semibold text-on-surface mt-2 group-hover:text-primary transition-colors\">Water Quality Monitoring</h3>\n              <div className=\"flex items-center gap-1.5 text-on-surface-variant font-lab