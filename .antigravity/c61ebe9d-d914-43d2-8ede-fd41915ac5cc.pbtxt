FBBF24]/30 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n              <motion.div initial={{ height: 0 }} whileInView={{ height: \'5%\' }} transition={{ duration: 0.8, ease: \"easeOut\", delay: 1.1 }} className=\"w-full bg-[#FBBF24]/20 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n              <motion.div initial={{ height: 0 }} whileInView={{ height: \'4%\' }} transition={{ duration: 0.8, ease: \"easeOut\", delay: 1.15 }} className=\"w-full bg-[#FBBF24]/20 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n            </div>\n            \n            {/* X-Axis Label */}\n            <div className=\"mt-xs text-center font-label-sm text-label-sm text-outline-variant tracking-wider uppercase\">\n              24 Districts\n            </div>\n            \n            {/* Legend */}\n            <div className=\"mt-md flex flex-wrap items-center justify-center gap-md font-label-sm text-label-sm text-outline-variant\">\n              <div className=\"flex items-center\"><div className=\"w-3 h-3 bg-[#FBBF24]/60 rounded-sm mr-xs\"></div> Low Density</div>\n              <div className=\"flex items-center\"><div className=\"w-3 h-3 bg-warning-amber/60 rounded-sm mr-xs\"></div> Medium Density</div>\n              <div className=\"flex items-center\"><div className=\"w-3 h-3 bg-error-red/80 rounded-sm mr-xs\"></div> High Density</div>\n            </div>\n          </motion.div>\n        </div>\n      </section>\n\n    </main>\n  );\n}"
