primary\">Matches: IIT ISM Dhanbad</span>\n</div>\n</div>\n</div>\n</div>\n{/* Column 4: In Progress */}\n<div className=\"flex-shrink-0 w-80 flex flex-col gap-sm bg-surface-container-low rounded-xl p-sm\">\n<div className=\"flex items-center justify-between px-2 pb-2 border-b border-outline-variant\">\n<h2 className=\"font-label-md text-label-md text-on-surface uppercase tracking-wider\">In Progress</h2>\n<span className=\"bg-surface-variant text-on-surface-variant rounded-full px-2 py-1 text-xs font-label-sm\">1</span>\n</div>\n<div className=\"flex flex-col gap-sm overflow-y-auto h-full pr-2\">\n{/* Card */}\n<div className=\"bg-surface-container-lowest p-sm rounded-lg shadow-sm border border-outline-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-shadow border-l-4 border-l-success-green\">\n<div className=\"flex justify-between items-start\">\n<span className=\"bg-error-container text-on-error-container text-[10px] font-bold px-2 py-1 rounded\">HIGH URGENCY</span>\n<button className=\"text-outline hover:text-primary\"><span className=\"material-symbols-outlined text-sm\" data-icon=\"more_vert\">more_vert</span></button>\n</div>\n<h3 className=\"font-headline-md text-lg leading-tight text-on-surface mt-1\">Maternal Health Dashboard</h3>\n<div className=\"flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm mt-2\">\n<span className=\"material-symbols-outlined text-xs\" data-icon=\"location_on\">location_on</span>\n<span>Godda</span>\n</div>\n<div className=\"mt-2 pt-2 border-t border-outline-variant flex items-center gap-2\">\n<div className=\"flex -space-x-2\">\n<div className=\"w-6 h-6 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold ring-2 ring-surface-container-lowest\">B</div>\n<div className=\"w-6 h-6 rounded-full bg-secondary flex items-center justify-center text-white text-xs font-bold ring-2 ring-surface-container-lowest\">I</div>\n</div>\n<span className=\"font-label-sm text-label-sm text-success-green ml-2\">Active: BIT Mesra Team</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n\n    </div>\n  );\n}\n\n```\n\n--- /src/app/challenges/[id]/page.tsx ---\n```typescript\n\'use client\';\n\nimport { useParams } from \'next/navigation\';\nimport { mockChallenges, mockProposals } from \'@/lib/data\';\nimport StatusBadge from \'@/components/StatusBadge\';\nimport Link from \'next/link\';\nimport { MapPin, ThumbsUp, MessageSquare, AlertTriangle, ArrowRight } from \'lucide-react\';\n\nexport default function ChallengeDetails() {\n  const params = useParams();\n  const challenge = mockChallenges.find(c => c.id === params.id);\n\n  if (!challenge) {\n    return (\n      <div className=\"max-w-7xl mx-auto px-4 py-20 text-center\">\n        <p className=\"text-5xl mb-4\">\360\237\230\225</p>\n        <h1 className=\"text-2xl font-bold text-gray-900\">Challenge not found</h1>\n        <Link href=\"/challenges\" className=\"text-blue-600 mt-4 inline-block\">\342\206\220 Back to all challenges</Link>\n      </div>\n    );\n  }\n\n  const proposals = mockProposals.filter(p => p.challengeId === challenge.id);\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\">\n      <Link href=\"/challenges\" className=\"text-sm text-blue-600 hover:text-blue-800 mb-4 inline-block\">\342\206\220 Back to Challenges</Link>\n\n      <div className=\"bg-white rounded-xl shadow-sm border p-6 mb-8\">\n        <div className=\"flex flex-col md:flex-row md:justify-between md:items-start gap-4\">\n          <div className=\"flex-1\">\n            <div className=\"flex items-center gap-2 mb-2\">\n              <StatusBadge status={challenge.status} />\n              <span className={`text-sm font-medium ${\n                challenge.urgency === \'Critical\' ? \'text-red-600\' : challenge.urgency === \'High\' ? \'text-orange-500\' : \'text-gray-500\'\n              }`}>\n                <AlertTriangle className=\"w-4 h-4 inline\" /> {challenge.urgency}\n              </span>\n            </div>\n            <h1 className=\"text-2xl font-bold text-gray-900\">{challenge.title}</h1>\n            <div className=\"flex items-center gap-4 mt-2 text-sm text-gray-500\">\n              <span className=\"flex items-center\"><MapPin className=\"w-4 h-4 mr-1\" />{challenge.district}</span>\n              <span className=\"flex items-center\"><ThumbsUp className=\"w-4 h-4 mr-1\" />{challenge.upvotes}</span>\n              <span className=\"flex items-center\"><MessageSquare className=\"w-4 h-4 mr-1\" />{challenge.comments} comments</span>\n              <span>Posted: {challenge.postedAt}</span>\n            </div>\n          </div>\n        </div>\n        <p className=\"text-gray-600 mt-4\">{challenge.description}</p>\n\n        <div className=\"mt-6 grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div>\n            <h3 className=\"text-sm font-semibold text-gray-900 mb-2\">Required Skills</h3>\n            <div className=\"flex flex-wrap gap-2\">\n              {challenge.requiredSkills.map(s => (\n                <span key={s} className=\"text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded-full ring-1 ring-blue-700/10\">{s}</span>\n              ))}\n            </div>\n          </div>\n          <div>\n            <h3 className=\"text-sm font-semibold text-gray-900 mb-2\">\360\237\247\240 AI-Matched Departments</h3>\n            <div className=\"space-y-1\">\n              {challenge.aiMatchedDepartments.map(d => (\n                <p key={d} className=\"text-sm text-indigo-600\">\342\200\242 {d}</p>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Proposals */}\n      <div className=\"flex items-center justify-between mb-4\">\n        <h2 className=\"text-xl font-bold text-gray-900\">Proposals ({proposals.length})</h2>\n        <button className=\"bg-blue-600 text-white px-4 py-2 rounded-full text-sm font-semibold hover:bg-blue-700\">Submit Proposal</button>\n      </div>\n      {proposals.length > 0 ? (\n        <div className=\"space-y-4\">\n          {proposals.map(p => (\n            <div key={p.id} className=\"bg-white rounded-xl shadow-sm border p-5\">\n              <div className=\"flex justify-between items-start\">\n                <div>\n                  <h3 className=\"font-semibold text-gray-900\">{p.teamName}</h3>\n                  <p className=\"text-sm text-blue-600\">{p.institution}</p>\n                </div>\n                <span className={`px-3 py-1 rounded-full text-xs font-semibold ${\n                  p.status === \'Accepted\' ? \'bg-green-100 text-green-700\' :\n                  p.status === \'Rejected\' ? \'bg-red-100 text-red-700\' : \'bg-yellow-100 text-yellow-800\'\n                }`}>{p.status}</span>\n              </div>\n              <p className=\"text-sm text-gray-600 mt-3\">{p.approach}</p>\n              <div className=\"flex flex-wrap gap-4 mt-3 text-xs text-gray-500\">\n                <span>\342\217\261\357\270\217 {p.timeline}</span>\n                <span>\360\237\222\260 {p.budgetRequest}</span>\n                <span>\342\255\220 Impact: {p.impactScore}</span>\n              </div>\n              {p.status === \'Accepted\' && (\n                <Link href={`/project/${p.challengeId}`} className=\"mt-3 inline-flex items-center text-sm text-blue-600 font-medium hover:text-blue-800\">\n                  View Project Workspace <ArrowRight className=\"w-4 h-4 ml-1\" />\n                </Link>\n              )}\n            </div>\n          ))}\n        </div>\n      ) : (\n        <div className=\"text-center py-16 bg-white rounded-xl border\">\n          <p className=\"text-5xl mb-4\">\360\237\222\241</p>\n          <p className=\"text-gray-500\">No proposals yet. Be the first to submit!</p>\n        </div>\n      )}\n    </div>\n  );\n}\n\n```\n\n--- /src/app/challenges/page.tsx ---\n```typescript\n\'use client\';\n\nimport { useState } from \'react\';\nimport { mockChallenges, Category } from \'@/lib/data\';\nimport ChallengeCard from \'@/components/ChallengeCard\';\nimport { Search, Filter } from \'lucide-react\';\n\nconst categories: Category[] = [\'Education\', \'Healthcare\', \'Agriculture\', \'Water Management\', \'Environment\', \'Public Service\', \'Mining Safety\', \'Tribal Welfare\'];\n\nexport default function ChallengesPage() {\n  const [filterCat, setFilterCat] = useState<string>(\'\');\n  const [filterStatus, setFilterStatus] = useState<string>(\'\');\n  const [search, setSearch] = useState(\'\');\n\n  const filtered = mockChallenges.filter(c =>\n    (!filterCat || c.category === filterCat) &&\n    (!filterStatus || c.status === filterStatus) &&\n    (!search || c.title.toLowerCase().includes(search.toLowerCase()))\n  );\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\">\n      <h1 className=\"text-3xl font-bold text-gray-900 mb-2\">All Challenges</h1>\n      <p className=\"text-gray-500 mb-6\">Browse all societal challenges across Jharkhand.</p>\n\n      <div className=\"flex flex-col md:flex-row gap-4 mb-6\">\n        <div className=\"relative flex-1\">\n          <Search className=\"absolute left-3 top-2.5 w-5 h-5 text-gray-400\" />\n          <input type=\"text\" value={search} onChange={(e) => setSearch(e.target.value)} placeholder=\"Search challenges...\" className=\"w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 text-sm focus:ring-2 focus:ring-blue-500\" />\n        </div>\n        <select value={filterCat} onChange={(e) => setFilterCat(e.target.value)} className=\"rounded-lg border border-gray-300 px-3 py-2 text-sm\">\n          <option value=\"\">All Categories</option>\n          {categories.map(c => <option key={c} value={c}>{c}</option>)}\n        </select>\n        <select value={filterStatus} onChange={(e) => setFilterStatus(e.target.value)} className=\"rounded-lg border border-gray-300 px-3 py-2 text-sm\">\n          <option value=\"\">All Status</option>\n          <option value=\"Reported\">Reported</option>\n          <option value=\"Validated\">Validated</option>\n          <option value=\"Open for Proposals\">Open for Proposals</option>\n          <option value=\"In Progress\">In Progress</option>\n          <option value=\"Resolved\">Resolved</option>\n        </select>\n      </div>\n\n      <p className=\"text-sm text-gray-500 mb-4\">{filtered.length} challenges found</p>\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filtered.map(c => <ChallengeCard key={c.id} challenge={c} />)}\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /src/app/citizen/page.tsx ---\n```typescript\nimport Link from \'next/link\';\n\nexport default function Page() {\n  return (\n    <div className=\"pt-16\">\n      \n{/* Left Side (60%): Report a Challenge Form */}\n<section className=\"w-full md:w-3/5 flex flex-col gap-md\">\n<div className=\"mb-sm\">\n<h1 className=\"font-headline-lg text-headline-lg text-on-surface mb-xs\">Report a Challenge</h1>\n<p className=\"text-on-surface-variant\">Submit detailed information about local issues to mobilize community solvers and state resources.</p>\n</div>\n<div className=\"bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant flex flex-col gap-md\">\n<div className=\"flex flex-col gap-xs\">\n<label className=\"font-label-md text-label-md text-on-surface\" for=\"title\">Title</label>\n<input className=\"px-4 py-3 border border-outline-variant rounded-lg text-body-md text-on-surface placeholder:text-outline bg-surface-container-lowest transition-colors w-full\" id=\"title\" placeholder=\"Brief, descriptive title of the issue\" type=\"text\"/>\n</div>\n<div className=\"grid grid-cols-1 sm:grid-cols-2 gap-md\">\n<div className=\"flex flex-col gap-xs\">\n<label className=\"font-label-md text-label-md text-on-surface\" for=\"category\">Category</label>\n<div className=\"relative\">\n<select className=\"appearance-none px-4 py-3 border border-outline-variant rounded-lg text-body-md text-on-surface bg-surface-container-lowest w-full pr-10\" id=\"category\">\n<option disabled=\"\" selected=\"\" value=\"\">Select Category</option>\n<option value=\"infrastructure\">Infrastructure &amp; Roads</option>\n<option value=\"water\">Water &amp; Sanitation</option>\n<option value=\"agriculture\">Agriculture &amp; Farming</option>\n<option value=\"education\">Education</option>\n<option value=\"health\">Public Health</option>\n</select>\n<span className=\"material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none\">expand_more</span>\n</div>\n</div>\n<div className=\"flex flex-col gap-xs\">\n<label className=\"font-label-md text-label-md text-on-surface\" for=\"district\">District</label>\n<div className=\"relative\">\n<select className=\"appearance-none px-4 py-3 border border-outline-variant rounded-lg text-body-md text-on-surface bg-surface-container-lowest w-full pr-10\" id=\"district\">\n<option disabled=\"\" selected=\"\" value=\"\">Select District</option>\n<option value=\"ranchi\">Ranchi</option>\n<option value=\"chatra\">Chatra</option>\n<option value=\"bokaro\">Bokaro</option>\n<option value=\"dhanbad\">Dhanbad</option>\n<option value=\"hazaribagh\">Hazaribagh</option>\n</select>\n<span className=\"material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none\">expand_more</span>\n</div>\n</div>\n</div>\n<div className=\"flex flex-col gap-xs\">\n<label className=\"font-label-md text-label-md text-on-surface\" for=\"description\">Description</label>\n<textarea className=\"px-4 py-3 border border-outline-variant rounded-lg text-body-md text-on-surface placeholder:text-outline bg-surface-container-lowest transition-colors w-full resize-y\" id=\"description\" placeholder=\"Provide detailed context, current impact, and location specifics...\" rows=\"5\"></textarea>\n</div>\n<div className=\"flex flex-col gap-xs\">\n<label className=\"font-label-md text-label-md text-on-surface\" for=\"skills\">Required Skills (Optional)</label>\n<input className=\"px-4 py-3 border border-outline-variant rounded-lg text-body-md text-on-surface placeholder:text-outline bg-surface-container-lowest transition-colors w-full\" id=\"skills\" placeholder=\"e.g., Civil Engineering, Data Analysis, Field Work\" type=\"text\"/>\n<p className=\"font-label-sm text-label-sm text-on-surface-variant mt-1\">Suggest skills that would help solve this challenge.</p>\n</div>\n<div className=\"mt-sm flex justify-end\">\n<button className=\"bg-primary text-on-primary font-label-md text-label-md px-6 py-3 rounded-lg hover:bg-secondary transition-colors shadow-sm flex items-center gap-2\">\n<span className=\"material-symbols-outlined text-[20px]\">send</span>\n                        Submit Challenge\n                    </button>\n</div>\n</div>\n</section>\n{/* Right Side (40%): Trending Local Challenges Feed */}\n<aside className=\"w-full md:w-2/5 flex flex-col gap-md h-[calc(100vh-120px)]\">\n<div className=\"flex justify-between items-center mb-xs\">\n<h2 className=\"font-headline-md text-headline-md text-on-surface\">Trending Local Challenges</h2>\n<button className=\"text-primary font-label-sm text-label-sm hover:underline flex items-center gap-1\">\n                    View Map <span className=\"material-symbols-outlined text-[16px]\">map</span>\n</button>\n</div>\n{/* Feed Container */}\n<div className=\"flex flex-col gap-sm overflow-y-auto custom-scrollbar pr-2 pb-sm\">\n{/* Challenge Card 1 */}\n<div className=\"bg-surface-container-lowest p-sm rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant hover:shadow-md transition-shadow group\">\n<div className=\"flex justify-between items-start mb-3\">\n<span className=\"inline-flex items-center px-2 py-1 rounded-[4px] bg-error-container text-on-error-container font-label-sm text-label-sm gap-1 uppercase tracking-wider\">\n<span className=\"material-symbols-outlined text-[14px] fill-icon\">warning</span>\n                            High Priority\n                        </span>\n<span className=\"text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\">\n<span className=\"material-symbols-outlined text-[16px]\">location_on</span>\n                            Chatra\n                        </span>\n</div>\n<h3 className=\"font-headline-md text-[20px] leading-tight font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors cursor-pointer\">Groundwater Depletion in Chatra</h3>\n<p className=\"text-on-surface-variant text-sm line-clamp-2 mb-4\">Severe drop in water table levels affecting local agriculture and daily water supply for over 500 households in the eastern block.</p>\n<div className=\"flex justify-between items-center pt-3 border-t border-surface-variant\">\n<div className=\"flex items-center gap-2\">\n<button className=\"flex items-center justify-center w-8 h-8 rounded-full bg-surface-container hover:bg-primary-container hover:text-on-primary-container transition-colors text-on-surface-variant\">\n<span className=\"material-symbols-outlined text-[20px]\">thumb_up</span>\n</button>\n<span className=\"font-label-md text-label-md text-on-surface\">245</span>\n</div>\n<span className=\"text-xs text-outline font-medium uppercase tracking-wider\">Water &amp; Sanitation</span>\n</div>\n</div>\n{/* Challenge Card 2 */}\n<div className=\"bg-surface-container-lowest p-sm rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant hover:shadow-md transition-shadow group\">\n<div className=\"flex justify-between items-start mb-3\">\n<span className=\"inline-flex items-center px-2 py-1 rounded-[4px] bg-warning-amber/10 text-warning-amber font-label-sm text-label-sm gap-1 uppercase tracking-wider\">\n<span className=\"material-symbols-outlined text-[14px]\">schedule</span>\n                            Medium Priority\n                        </span>\n<span className=\"text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\">\n<span className=\"material-symbols-outlined text-[16px]\">location_on</span>\n                            Ranchi\n                        </span>\n</div>\n<h3 className=\"font-headline-md text-[20px] leading-tight font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors cursor-pointer\">Traffic Congestion at Main Road Junction</h3>\n<p className=\"text-on-surface-variant text-sm line-clamp-2 mb-4\">Daily bottleneck during peak hours causing severe delays and increasing localized air pollution levels significantly.</p>\n<div className=\"flex justify-between items-center pt-3 border-t border-surface-variant\">\n<div className=\"flex items-center gap-2\">\n<button className=\"flex items-center justify-center w-8 h-8 rounded-full bg-surface-container hover:bg-primary-container hover:text-on-primary-container transition-colors text-on-surface-variant\">\n<span className=\"material-symbols-outlined text-[20px]\">thumb_up</span>\n</button>\n<span className=\"font-label-md text-label-md text-on-surface\">182</span>\n</div>\n<span className=\"text-xs text-outline font-medium uppercase tracking-wider\">Infrastructure</span>\n</div>\n</div>\n{/* Challenge Card 3 */}\n<div className=\"bg-surface-container-lowest p-sm rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant hover:shadow-md transition-shadow group\">\n<div className=\"flex justify-between items-start mb-3\">\n<span className=\"inline-flex items-center px-2 py-1 rounded-[4px] bg-error-container text-on-error-container font-label-sm text-label-sm gap-1 uppercase tracking-wider\">\n<span className=\"material-symbols-outlined text-[14px] fill-icon\">warning</span>\n                            High Priority\n                        </span>\n<span className=\"text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\">\n<span className=\"material-symbols-outlined text-[16px]\">location_on</span>\n                            Bokaro\n                        </span>\n</div>\n<h3 className=\"font-headline-md text-[20px] leading-tight font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors cursor-pointer\">Industrial Waste Dumping in Damodar River</h3>\n<p className=\"text-on-surface-variant text-sm line-clamp-2 mb-4\">Unauthorized discharge of effluents is affecting aquatic life and threatening downstream water utility intakes.</p>\n<div className=\"flex justify-between items-center pt-3 border-t border-surface-variant\">\n<div className=\"flex items-center gap-2\">\n<button className=\"flex items-center justify-center w-8 h-8 rounded-full bg-surface-container hover:bg-primary-container hover:text-on-primary-container transition-colors text-on-surface-variant\">\n<span className=\"material-symbols-outlined text-[20px]\">thumb_up</span>\n</button>\n<span className=\"font-label-md text-label-md text-on-surface\">410</span>\n</div>\n<span className=\"text-xs text-outline font-medium uppercase tracking-wider\">Public Health</span>\n</div>\n</div>\n</div>\n</aside>\n\n    </div>\n  );\n}\n\n```\n\n--- /src/app/globals.css ---\n```css\n@import \"tailwindcss\";\n\n@theme {\n  --color-on-secondary-container: #fffbff;\n  --color-on-primary: #ffffff;\n  --color-on-tertiary-container: #ffc9b7;\n  --color-on-tertiary-fixed-variant: #832700;\n  --color-primary: #0037b0;\n  --color-inverse-primary: #b7c4ff;\n  --color-error-red: #B91C1C;\n  --color-primary-fixed: #dce1ff;\n  --color-tertiary-fixed-dim: #ffb59c;\n  --color-error-container: #ffdad6;\n  --color-on-background: #191c1d;\n  --color-tertiary-fixed: #ffdbcf;\n  --color-inverse-surface: #2e3132;\n  --color-on-secondary-fixed-variant: #372abf;\n  --color-background: #f8f9fa;\n  --color-outline: #747686;\n  --color-success-green: #15803D;\n  --color-tertiary-container: #a73400;\n  --color-surface-container-highest: #e1e3e4;\n  --color-on-secondary-fixed: #100069;\n  --color-primary-container: #1d4ed8;\n  --color-on-surface: #191c1d;\n  --color-error: #ba1a1a;\n  --color-on-primary-container: #cad3ff;\n  --color-surface-container: #edeeef;\n  --color-surface-variant: #e1e3e4;\n  --color-surface-dark: #111827;\n  --color-secondary: #4e45d5;\n  --color-on-error: #ffffff;\n  --color-data-viz-bg: #1F2937;\n  --color-surface-container-low: #f3f4f5;\n  --color-on-error-container: #93000a;\n  --color-secondary-fixed: #e3dfff;\n  --color-on-surface-variant: #434655;\n  --color-inverse-on-surface: #f0f1f2;\n  --color-surface-bright: #f8f9fa;\n  --color-primary-fixed-dim: #b7c4ff;\n  --color-on-primary-fixed: #001551;\n  --color-surface-container-lowest: #ffffff;\n  --color-tertiary: #7f2500;\n  --color-secondary-container: #6860ef;\n  --color-secondary-fixed-dim: #c3c0ff;\n  --color-on-primary-fixed-variant: #0039b5;\n  --color-surface-dim: #d9dadb;\n  --color-surface: #f8f9fa;\n  --color-on-tertiary: #ffffff;\n  --color-warning-amber: #B45309;\n  --color-on-tertiary-fixed: #390c00;\n  --color-surface-container-high: #e7e8e9;\n  --color-on-secondary: #ffffff;\n  --color-surface-tint: #2151da;\n  --color-outline-variant: #c4c5d7;\n  --spacing-sm: 16px;\n  --spacing-xl: 64px;\n  --spacing-xs: 8px;\n  --spacing-md: 24px;\n  --spacing-base: 4px;\n  --spacing-lg: 40px;\n  --spacing-gutter: 24px;\n  --spacing-container-max: 1280px;\n  --text-display-lg: 48px;\n  --text-display-lg--line-height: 56px;\n  --font-display-lg: \"Public Sans\", sans-serif;\n  --text-display-lg-mobile: 36px;\n  --text-display-lg-mobile--line-height: 44px;\n  --font-display-lg-mobile: \"Public Sans\", sans-serif;\n  --text-headline-lg: 32px;\n  --text-headline-lg--line-height: 40px;\n  --font-headline-lg: \"Public Sans\", sans-serif;\n  --text-headline-md: 24px;\n  --text-headline-md--line-height: 32px;\n  --font-headline-md: \"Public Sans\", sans-serif;\n  --text-body-lg: 18px;\n  --text-body-lg--line-height: 28px;\n  --font-body-lg: \"Inter\", sans-serif;\n  --text-body-md: 16px;\n  --text-body-md--line-height: 24px;\n  --font-body-md: \"Inter\", sans-serif;\n  --text-label-md: 14px;\n  --text-label-md--line-height: 20px;\n  --font-label-md: \"Inter\", sans-serif;\n  --text-label-sm: 12px;\n  --text-label-sm--line-height: 16px;\n  --font-label-sm: \"Inter\", sans-serif;\n}\n\nbody { background-color: var(--color-background); color: var(--color-on-background); }\n\n```\n\n--- /src/app/industry/page.tsx ---\n```typescript\n\'use client\';\n\nimport { mockProposals, mockChallenges } from \'@/lib/data\';\nimport { Briefcase, DollarSign, TrendingUp, Users } from \'lucide-react\';\n\nexport default function IndustryPortal() {\n  const acceptedProposals = mockProposals.filter(p => p.status === \'Accepted\');\n  const totalBudget = acceptedProposals.reduce((sum, p) => {\n    const num = parseInt(p.budgetRequest.replace(/[^0-9]/g, \'\'));\n    return sum + (isNaN(num) ? 0 : num);\n  }, 0);\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\">\n      <div className=\"mb-8\">\n        <h1 className=\"text-3xl font-bold text-gray-900\">\360\237\217\255 Industry Partner Portal</h1>\n        <p className=\"text-gray-500 mt-1\">Fund, mentor, and power innovation-driven solutions for Jharkhand.</p>\n      </div>\n\n      {/* Stats */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-4 gap-4 mb-8\">\n        <div className=\"bg-white rounded-xl shadow-sm border p-5 text-center\">\n          <Briefcase className=\"w-8 h-8 mx-auto mb-2 text-purple-600\" />\n          <p className=\"text-2xl font-bold text-gray-900\">{acceptedProposals.length}</p>\n          <p className=\"text-xs text-gray-500\">Approved Proposals</p>\n        </div>\n        <div className=\"bg-white rounded-xl shadow-sm border p-5 text-center\">\n          <DollarSign className=\"w-8 h-8 mx-auto mb-2 text-green-600\" />\n          <p className=\"text-2xl font-bold text-gray-900\">\342\202\271{(totalBudget / 100).toFixed(0)}L</p>\n          <p className=\"text-xs text-gray-500\">Total Funding Needed</p>\n        </div>\n        <div className=\"bg-white rounded-xl shadow-sm border p-5 text-center\">\n          <Users className=\"w-8 h-8 mx-auto mb-2 text-blue-600\" />\n          <p className=\"text-2xl font-bold text-gray-900\">14</p>\n          <p className=\"text-xs text-gray-500\">Active Partners</p>\n        </div>\n        <div className=\"bg-white rounded-xl shadow-sm border p-5 text-center\">\n          <TrendingUp className=\"w-8 h-8 mx-auto mb-2 text-orange-600\" />\n          <p className=\"text-2xl font-bold text-gray-900\">89%</p>\n          <p className=\"text-xs text-gray-500\">Success Rate</p>\n        </div>\n      </div>\n\n      {/* Proposals Ready for Funding */}\n      <h2 className=\"text-xl font-bold text-gray-900 mb-4\">Proposals Ready for Sponsorship</h2>\n      <div className=\"space-y-4\">\n        {acceptedProposals.map(p => {\n          const challenge = mockChallenges.find(c => c.id === p.challengeId);\n          return (\n            <div key={p.id} className=\"bg-white rounded-xl shadow-sm border overflow-hidden\">\n              <div className=\"p-6\">\n                <div className=\"flex flex-col md:flex-row md:justify-between md:items-start gap-4\">\n                  <div className=\"flex-1\">\n                    <p className=\"text-xs text-gray-400 mb-1\">SOLVING: {challenge?.title || \'Unknown Challenge\'}</p>\n                    <h3 className=\"text-lg font-bold text-gray-900\">{p.teamName}</h3>\n                    <p className=\"text-sm text-blue-600 font-medium\">{p.institution}</p>\n                    <p className=\"text-sm text-gray-600 mt-3\">{p.approach}</p>\n                    <div className=\"flex flex-wrap gap-4 mt-4 text-sm text-gray-500\">\n                      <span>\342\217\261\357\270\217 {p.timeline}</span>\n                      <span>\360\237\222\260 {p.budgetRequest}</span>\n                      <span>\342\255\220 Impact: {p.impactScore}/100</span>\n                    </div>\n                    <div className=\"mt-3 flex flex-wrap gap-1\">\n                      {p.teamMembers.map(m => (\n                        <span key={m} className=\"text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full\">{m}</span>\n                      ))}\n                    </div>\n                  </div>\n                  <div className=\"flex flex-col gap-2\">\n                    <button className=\"bg-purple-600 text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-purple-700 transition\">\360\237\222\274 Sponsor This</button>\n                    <button className=\"border border-purple-600 text-purple-600 px-5 py-2 rounded-full text-sm font-semibold hover:bg-purple-50 transition\">\360\237\244\235 Offer Mentorship</button>\n                  </div>\n                </div>\n              </div>\n              {/* AI Match Tag */}\n              {challenge && (\n                <div className=\"bg-indigo-50 px-6 py-3 border-t\">\n                  <p className=\"text-xs font-semibold text-indigo-700\">\360\237\247\240 AI Match Confidence: 94% \342\200\224 This proposal strongly aligns with {challenge.category} expertise</p>\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n\n      {/* CSR Impact Tracker */}\n      <div className=\"mt-12 bg-gradient-to-br from-purple-700 to-indigo-800 rounded-2xl p-8 text-white\">\n        <h2 className=\"text-2xl font-bold mb-4\">\360\237\223\212 Your CSR Impact Dashboard</h2>\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          <div className=\"bg-white/10 rounded-xl p-5 backdrop-blur\">\n            <p className=\"text-3xl font-bold\">\342\202\27145L</p>\n            <p className=\"text-purple-200 text-sm\">Total CSR Investment</p>\n          </div>\n          <div className=\"bg-white/10 rounded-xl p-5 backdrop-blur\">\n            <p className=\"text-3xl font-bold\">12,000+</p>\n            <p className=\"text-purple-200 text-sm\">Lives Impacted</p>\n          </div>\n          <div className=\"bg-white/10 rounded-xl p-5 backdrop-blur\">\n            <p className=\"text-3xl font-bold\">5</p>\n            <p className=\"text-purple-200 text-sm\">Districts Covered</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /src/app/layout.tsx ---\n```typescript\nimport type { Metadata } from \'next\';\nimport { Geist, Geist_Mono } from \'next/font/google\';\nimport \'./globals.css\';\nimport Navbar from \'@/components/Navbar\';\nimport Footer from \'@/components/Footer\';\nimport { AppProvider } from \'@/lib/AppContext\';\n\nconst geistSans = Geist({ variable: \'--font-geist-sans\', subsets: [\'latin\'] });\nconst geistMono = Geist_Mono({ variable: \'--font-geist-mono\', subsets: [\'latin\'] });\n\nexport const metadata: Metadata = {\n  title: \'CollabSolve Jharkhand \342\200\224 Crowdsource Societal Challenges\',\n  description: \'A digital platform to crowdsource societal challenges and facilitate collaborative problem solving through universities and industry partnerships. SIH26043.\',\n};\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n  return (\n    <html lang=\"en\" className={`${geistSans.variable} ${geistMono.variable} h-full antialiased`}>\n      <head>\n        <link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\" rel=\"stylesheet\" />\n      </head>\n      <body className=\"min-h-full flex flex-col bg-background text-on-background font-body-md text-body-md\">\n        <AppProvider>\n          <Navbar />\n          <main className=\"flex-1 pt-16\">{children}</main>\n          <Footer />\n        </AppProvider>\n      </body>\n    </html>\n  );\n}\n\n```\n\n--- /src/app/page.tsx ---\n```typescript\nimport Link from \'next/link\';\n\nexport default function Home() {\n  return (\n    <main>\n      \n{/* Hero Section */}\n<section className=\"relative overflow-hidden bg-gradient-to-br from-primary to-secondary py-xl lg:py-[120px] px-gutter\">\n{/* Decorative background pattern */}\n<div className=\"absolute inset-0 opacity-10\" style={{\"backgroundImage\": \"radial-gradient(circle at 2px 2px, white 1px, transparent 0)\", \"backgroundSize\": \"32px 32px\"}}></div>\n<div className=\"max-w-container-max mx-auto relative z-10 flex flex-col items-center text-center\">\n<h1 className=\"font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-on-primary mb-md max-w-4xl tracking-tight\">\n                    Jharkhand\'s Problems. India\'s Brightest Minds. Together.\n                </h1>\n<p className=\"font-body-lg text-body-lg text-primary-fixed-dim mb-xl max-w-2xl\">\n                    A collaborative platform connecting the citizens of Jharkhand with universities, industry experts, and government bodies to architect data-driven solutions for real-world civic challenges.\n                </p>\n<div className=\"flex flex-col sm:flex-row gap-md\">\n<button className=\"font-label-md text-label-md bg-on-primary text-primary px-8 py-3 rounded-lg shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:shadow-[0_6px_16px_rgba(0,0,0,0.15)] transition-all active:scale-95\">\n                        Report a Challenge\n                    </button>\n<button className=\"font-label-md text-label-md bg-transparent border-2 border-on-primary text-on-primary px-8 py-3 rounded-lg hover:bg-on-primary/10 transition-all active:scale-95\">\n                        Solve a Challenge\n                    </button>\n</div>\n</div>\n</section>\n{/* Stats Section (Bento Grid Style) */}\n<section className=\"max-w-container-max mx-auto px-gutter -mt-xl relative z-20 pb-xl\">\n<div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-sm\">\n{/* Stat Card 1 */}\n<div className=\"glass-panel bg-surface-container-lowest rounded-xl p-md shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant flex items-start space-x-sm\">\n<div className=\"p-xs bg-error-container rounded-lg text-error-red flex-shrink-0\">\n<span className=\"material-symbols-outlined\" >report</span>\n</div>\n<div>\n<div className=\"font-headline-lg text-headline-lg text-on-surface mb-base\">289</div>\n<div className=\"font-label-md text-label-md text-on-surface-variant\">Challenges Reported</div>\n</div>\n</div>\n{/* Stat Card 2 */}\n<div className=\"glass-panel bg-surface-container-lowest rounded-xl p-md shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant flex items-start space-x-sm\">\n<div className=\"p-xs bg-primary-fixed rounded-lg text-primary flex-shrink-0\">\n<span className=\"material-symbols-outlined\" >description</span>\n</div>\n<div>\n<div className=\"font-headline-lg text-headline-lg text-on-surface mb-base\">147</div>\n<div className=\"font-label-md text-label-md text-on-surface-variant\">Proposals Submitted</div>\n</div>\n</div>\n{/* Stat Card 3 */}\n<div className=\"glass-panel bg-surface-container-lowest rounded-xl p-md shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant flex items-start space-x-sm\">\n<div className=\"p-xs bg-[#DCFCE7] rounded-lg text-success-green flex-shrink-0\">\n<span className=\"material-symbols-outlined\" >check_circle</span>\n</div>\n<div>\n<div className=\"font-headline-lg text-headline-lg text-on-surface mb-base\">43</div>\n<div className=\"font-label-md text-label-md text-on-surface-variant\">Problems Resolved</div>\n</div>\n</div>\n{/* Stat Card 4 */}\n<div className=\"glass-panel bg-surface-container-lowest rounded-xl p-md shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant flex items-start space-x-sm\">\n<div className=\"p-xs bg-secondary-fixed rounded-lg text-secondary flex-shrink-0\">\n<span className=\"material-symbols-outlined\" >handshake</span>\n</div>\n<div>\n<div className=\"font-headline-lg text-headline-lg text-on-surface mb-base\">56</div>\n<div className=\"font-label-md text-label-md text-on-surface-variant\">Active Partners</div>\n</div>\n</div>\n</div>\n</section>\n{/* How It Works Section */}\n<section className=\"py-xl bg-surface-container-low\">\n<div className=\"max-w-container-max mx-auto px-gutter\">\n<div className=\"text-center mb-xl\">\n<h2 className=\"font-headline-md text-headline-md md:font-headline-lg md:text-headline-lg text-on-surface mb-sm\">The Collaboration Lifecycle</h2>\n<p className=\"font-body-md text-body-md text-on-surface-variant max-w-2xl mx-auto\">A structured approach from problem identification to deployed solution.</p>\n</div>\n<div className=\"flex flex-col lg:flex-row items-center justify-between gap-md relative\">\n{/* Connecting Line (Desktop) */}\n<div className=\"hidden lg:block absolute top-1/2 left-0 w-full h-[2px] bg-outline-variant -z-10 -translate-y-1/2\"></div>\n{/* Step 1 */}\n<div className=\"bg-surface-container-lowest rounded-xl p-md shadow-sm border border-surface-variant w-full lg:w-1/4 relative z-10 flex flex-col items-center text-center\">\n<div className=\"w-12 h-12 rounded-full bg-primary text-on-primary flex items-center justify-center font-headline-md text-headline-md mb-sm shadow-sm ring-4 ring-surface-container-lowest\">1</div>\n<h3 className=\"font-label-md text-label-md text-on-surface mb-base\">Citizens Report</h3>\n<p className=\"font-label-sm text-label-sm text-on-surface-variant\">Local issues are mapped and documented through community input.</p>\n</div>\n{/* Arrow (Mobile) */}\n<div className=\"block lg:hidden text-outline-variant\">\n<span className=\"material-symbols-outlined\">arrow_downward</span>\n</div>\n{/* Step 2 */}\n<div className=\"bg-surface-container-lowest rounded-xl p-md shadow-sm border border-surface-variant w-full lg:w-1/4 relative z-10 flex flex-col items-center text-center\">\n<div className=\"w-12 h-12 rounded-full bg-secondary text-on-primary flex items-center justify-center font-headline-md text-headline-md mb-sm shadow-sm ring-4 ring-surface-container-lowest\">2</div>\n<h3 className=\"font-label-md text-label-md text-on-surface mb-base\">Government Validates</h3>\n<p className=\"font-label-sm text-label-sm text-on-surface-variant\">Authorities verify and prioritize data for intervention.</p>\n</div>\n{/* Arrow (Mobile) */}\n<div className=\"block lg:hidden text-outline-variant\">\n<span className=\"material-symbols-outlined\">arrow_downward</span>\n</div>\n{/* Step 3 */}\n<div className=\"bg-surface-container-lowest rounded-xl p-md shadow-sm border border-surface-variant w-full lg:w-1/4 relative z-10 flex flex-col items-center text-center\">\n<div className=\"w-12 h-12 rounded-full bg-tertiary text-on-primary flex items-center justify-center font-headline-md text-headline-md mb-sm shadow-sm ring-4 ring-surface-container-lowest\">3</div>\n<h3 className=\"font-label-md text-label-md text-on-surface mb-base\">Universities Innovate</h3>\n<p className=\"font-label-sm text-label-sm text-on-surface-variant\">Academic teams propose research-backed prototypes.</p>\n</div>\n{/* Arrow (Mobile) */}\n<div className=\"block lg:hidden text-outline-variant\">\n<span className=\"material-symbols-outlined\">arrow_downward</span>\n</div>\n{/* Step 4 */}\n<div className=\"bg-surface-container-lowest rounded-xl p-md shadow-sm border border-surface-variant w-full lg:w-1/4 relative z-10 flex flex-col items-center text-center\">\n<div className=\"w-12 h-12 rounded-full bg-success-green text-on-primary flex items-center justify-center font-headline-md text-headline-md mb-sm shadow-sm ring-4 ring-surface-container-lowest\">4</div>\n<h3 className=\"font-label-md text-label-md text-on-surface mb-base\">Industry Powers</h3>\n<p className=\"font-label-sm text-label-sm text-on-surface-variant\">Private partners scale and deploy solutions locally.</p>\n</div>\n</div>\n</div>\n</section>\n{/* Heatmap Section (Data Viz) */}\n<section className=\"py-xl bg-data-viz-bg text-on-primary\">\n<div className=\"max-w-container-max mx-auto px-gutter\">\n<div className=\"mb-lg\">\n<h2 className=\"font-headline-md text-headline-md text-on-primary mb-xs\">Challenge Density by District</h2>\n<p className=\"font-body-md text-body-md text-outline-variant\">Real-time visualization of reported civic issues across Jharkhand\'s 24 districts.</p>\n</div>\n{/* Chart Container */}\n<div className=\"bg-surface-dark rounded-xl p-md border border-outline/20\">\n<div className=\"h-64 sm:h-96 flex items-end justify-between gap-1 sm:gap-2 pb-sm border-b border-outline-variant relative\">\n{/* Y-Axis Label */}\n<div className=\"absolute -left-6 top-1/2 -translate-y-1/2 -rotate-90 font-label-sm text-label-sm text-outline-variant tracking-wider uppercase\">\n                            Challenge Count\n                        </div>\n{/* Y-axis Grid Lines (Decorative) */}\n<div className=\"absolute inset-x-0 top-0 h-px bg-outline/10\"></div>\n<div className=\"absolute inset-x-0 top-1/4 h-px bg-outline/10\"></div>\n<div className=\"absolute inset-x-0 top-2/4 h-px bg-outline/10\"></div>\n<div className=\"absolute inset-x-0 top-3/4 h-px bg-outline/10\"></div>\n{/* Bar Data (Simulated 24 Districts) */}\n{/* High Density (Reds) */}\n<div className=\"w-full bg-error-red/80 rounded-t-sm chart-bar relative group hover:bg-error-red transition-colors\" style={{\"height\": \"85%\"}}>\n<div className=\"opacity-0 group-hover:opacity-100 absolute -top-8 left-1/2 -translate-x-1/2 bg-surface-container-lowest text-on-surface font-label-sm text-label-sm px-2 py-1 rounded shadow-lg pointer-events-none transition-opacity\">Ranchi: 120</div>\n</div>\n<div className=\"w-full bg-error-red/70 rounded-t-sm chart-bar relative group hover:bg-error-red transition-colors\" style={{\"height\": \"75%\"}}>\n<div className=\"opacity-0 group-hover:opacity-100 absolute -top-8 left-1/2 -translate-x-1/2 bg-surface-container-lowest text-on-surface font-label-sm text-label-sm px-2 py-1 rounded shadow-lg pointer-events-none transition-opacity\">Dhanbad: 105</div>\n</div>\n{/* Medium Density (Ambers/Oranges) */}\n<div className=\"w-full bg-warning-amber/80 rounded-t-sm chart-bar relative group hover:bg-warning-amber transition-colors\" style={{\"height\": \"60%\"}}></div>\n<div className=\"w-full bg-warning-amber/70 rounded-t-sm chart-bar relative group hover:bg-warning-amber transition-colors\" style={{\"height\": \"55%\"}}></div>\n<div className=\"w-full bg-warning-amber/60 rounded-t-sm chart-bar relative group hover:bg-warning-amber transition-colors\" style={{\"height\": \"50%\"}}></div>\n<div className=\"w-full bg-warning-amber/50 rounded-t-sm chart-bar relative group hover:bg-warning-amber transition-colors\" style={{\"height\": \"48%\"}}></div>\n<div className=\"w-full bg-warning-amber/50 rounded-t-sm chart-bar relative group hover:bg-warning-amber transition-colors\" style={{\"height\": \"45%\"}}></div>\n<div className=\"w-full bg-warning-amber/40 rounded-t-sm chart-bar relative group hover:bg-warning-amber transition-colors\" style={{\"height\": \"42%\"}}></div>\n<div className=\"w-full bg-warning-amber/40 rounded-t-sm chart-bar relative group hover:bg-warning-amber transition-colors\" style={{\"height\": \"40%\"}}></div>\n<div className=\"w-full bg-warning-amber/30 rounded-t-sm chart-bar relative group hover:bg-warning-amber transition-colors\" style={{\"height\": \"38%\"}}></div>\n<div className=\"w-full bg-warning-amber/30 rounded-t-sm chart-bar relative group hover:bg-warning-amber transition-colors\" style={{\"height\": \"35%\"}}></div>\n{/* Low Density (Yellows/Lighter) */}\n<div className=\"w-full bg-[#FBBF24]/80 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"30%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/70 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"28%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/70 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"25%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/60 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"22%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/60 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"20%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/50 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"18%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/50 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"15%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/40 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"12%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/40 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"10%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/30 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"8%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/30 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"7%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/20 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"5%\"}}></div>\n<div className=\"w-full bg-[#FBBF24]/20 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\" style={{\"height\": \"4%\"}}></div>\n</div>\n{/* X-Axis Label */}\n<div className=\"mt-xs text-center font-label-sm text-label-sm text-outline-variant tracking-wider uppercase\">\n                        24 Districts\n                    </div>\n{/* Legend */}\n<div className=\"mt-md flex items-center justify-center space-x-md font-label-sm text-label-sm text-outline-variant\">\n<div className=\"flex items-center\"><div className=\"w-3 h-3 bg-[#FBBF24]/60 rounded-sm mr-xs\"></div> Low Density</div>\n<div className=\"flex items-center\"><div className=\"w-3 h-3 bg-warning-amber/60 rounded-sm mr-xs\"></div> Medium Density</div>\n<div className=\"flex items-center\"><div className=\"w-3 h-3 bg-error-red/80 rounded-sm mr-xs\"></div> High Density</div>\n</div>\n</div>\n</div>\n</section>\n\n    </main>\n  );\n}\n\n```\n\n--- /src/app/project/[id]/page.tsx ---\n```typescript\nimport Link from \'next/link\';\n\nexport default function Page() {\n  return (\n    <div className=\"pt-16\">\n      \n{/* Header Section */}\n<header className=\"mb-xl\">\n<h1 className=\"font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-md\">Water Management in Chatra</h1>\n{/* Progress Pipeline */}\n<div className=\"bg-surface-container-lowest rounded-lg p-md shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant mt-lg overflow-x-auto\">\n<div className=\"min-w-[700px] flex justify-between items-center relative\">\n{/* Progress Line Background */}\n<div className=\"absolute top-1/2 left-[10%] right-[10%] h-[2px] bg-outline-variant -translate-y-1/2 z-0\"></div>\n{/* Progress Line Active */}\n<div className=\"absolute top-1/2 left-[10%] right-[30%] h-[2px] bg-primary -translate-y-1/2 z-0\"></div>\n{/* Stage 1 */}\n<div className=\"flex flex-col items-center z-10 w-[20%]\">\n<div className=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-sm mb-xs\">\n<span className=\"material-symbols-outlined text-sm\" >check</span>\n</div>\n<span className=\"font-label-sm text-label-sm text-on-surface\">Reported</span>\n</div>\n{/* Stage 2 */}\n<div className=\"flex flex-col items-center z-10 w-[20%]\">\n<div className=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-sm mb-xs\">\n<span className=\"material-symbols-outlined text-sm\" >check</span>\n</div>\n<span className=\"font-label-sm text-label-sm text-on-surface\">Validated</span>\n</div>\n{/* Stage 3 */}\n<div className=\"flex flex-col items-center z-10 w-[20%]\">\n<div className=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-sm mb-xs\">\n<span className=\"material-symbols-outlined text-sm\" >check</span>\n</div>\n<span className=\"font-label-sm text-label-sm text-on-surface\">Open for Proposals</span>\n</div>\n{/* Stage 4 (Active) */}\n<div className=\"flex flex-col items-center z-10 w-[20%] relative\">\n<div className=\"absolute -inset-2 bg-primary-fixed rounded-full animate-pulse opacity-50 z-[-1]\"></div>\n<div className=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-md mb-xs ring-4 ring-primary-fixed\">\n<span className=\"material-symbols-outlined text-sm\">engineering</span>\n</div>\n<span className=\"font-label-sm text-label-sm text-primary font-bold\">In Progress</span>\n</div>\n{/* Stage 5 */}\n<div className=\"flex flex-col items-center z-10 w-[20%]\">\n<div className=\"w-8 h-8 rounded-full bg-surface-container-high border-2 border-outline-variant flex items-center justify-center text-outline mb-xs\">\n<span className=\"material-symbols-outlined text-sm\">done_all</span>\n</div>\n<span className=\"font-label-sm text-label-sm text-on-surface-variant\">Resolved</span>\n</div>\n</div>\n</div>\n</header>\n{/* Two Column Layout */}\n<div className=\"grid grid-cols-1 lg:grid-cols-12 gap-gutter\">\n{/* Left Column (70%) */}\n<div className=\"lg:col-span-8 flex flex-col gap-lg\">\n{/* Milestone Timeline Section */}\n<section className=\"bg-surface-container-lowest rounded-lg p-md shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant\">\n<h2 className=\"font-headline-md text-headline-md text-on-surface mb-md\">Project Milestones</h2>\n<div className=\"relative border-l-2 border-surface-variant ml-sm space-y-md py-sm\">\n{/* Milestone 1 */}\n<div className=\"relative pl-md\">\n<div className=\"absolute w-3 h-3 bg-primary rounded-full -left-[7px] top-1.5 ring-4 ring-surface-container-lowest\"></div>\n<div className=\"bg-surface rounded-lg p-sm border border-surface-variant\">\n<h3 className=\"font-label-md text-label-md text-on-surface mb-xs\">Phase 1: Problem Mapping</h3>\n<p className=\"font-body-md text-body-md text-on-surface-variant text-sm\">Initial survey of Chatra\'s water distribution networks completed. Key leakage points identified in sectors 4 and 7.</p>\n<div className=\"mt-xs inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#E6F4EA] text-success-green uppercase tracking-wider\">\n                                    Completed\n                                </div>\n</div>\n</div>\n{/* Milestone 2 (Active) */}\n<div className=\"relative pl-md\">\n<div className=\"absolute w-3 h-3 bg-secondary rounded-full -left-[7px] top-1.5 ring-4 ring-primary-fixed animate-pulse\"></div>\n<div className=\"bg-primary-fixed/20 rounded-lg p-sm border border-primary/20 shadow-sm\">\n<h3 className=\"font-label-md text-label-md text-primary mb-xs\">Phase 2: Sensor Deployment</h3>\n<p className=\"font-body-md text-body-md text-on-surface-variant text-sm\">Currently installing IoT flow sensors at main reservoir junctions to monitor real-time pressure and detect anomalies.</p>\n<div className=\"mt-xs inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#FEF3C7] text-warning-amber uppercase tracking-wider\">\n                                    In Progress\n                                </div>\n</div>\n</div>\n{/* Milestone 3 */}\n<div className=\"relative pl-md\">\n<div className=\"absolute w-3 h-3 bg-outline-variant rounded-full -left-[7px] top-1.5 ring-4 ring-surface-container-lowest\"></div>\n<div className=\"bg-surface-container-low rounded-lg p-sm border border-surface-variant opacity-70\">\n<h3 className=\"font-label-md text-label-md text-on-surface-variant mb-xs\">Phase 3: Data Analysis</h3>\n<p className=\"font-body-md text-body-md text-on-surface-variant text-sm\">Integration of sensor data into central dashboard for predictive maintenance and automated alerts.</p>\n<div className=\"mt-xs inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-surface-variant text-on-surface-variant uppercase tracking-wider\">\n                                    Pending\n                                </div>\n</div>\n</div>\n</div>\n</section>\n{/* Progress Updates Feed */}\n<section className=\"bg-surface-container-lowest rounded-lg p-md shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant\">\n<div className=\"flex justify-between items-center mb-md\">\n<h2 className=\"font-headline-md text-headline-md text-on-surface\">Updates Feed</h2>\n<button className=\"text-primary hover:text-secondary font-label-md text-label-md flex items-center gap-xs\">\n<span className=\"material-symbols-outlined text-sm\">filter_list</span> Filter\n                        </button>\n</div>\n<div className=\"space-y-md\">\n{/* Feed Item 1 */}\n<article className=\"flex gap-sm pb-md border-b border-surface-variant last:border-0 last:pb-0\">\n<img className=\"w-10 h-10 rounded-full object-cover shrink-0 bg-surface-variant\" data-alt=\"A professional headshot of an engineering student in a clean, modern lab setting. The lighting is bright and even, casting soft shadows. The overall aesthetic is corporate modern and technical. The color palette is dominated by neutral grays and whites with subtle blue accents in the background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDwMMZIDizAwZZwvg9LlHXWJFcQ-GCb-TS8w49aGftf5WXpSmUViZFluH51vYC7bwekeq-dT1ikOWUvPHCSdvVoWsXSz7OBf7AU_13CdQhltH_nDTIcq66DeRXnlHpCf3YemV_8T8equZeMcpZO4-83l0LVCB_okxqV5rJHZLCtviNrgo0gA2JjayFJn_3TFjdtvliy1yyAS96zicnUWjkryfyNFlU0mjd9LaUr82c6H5CvZRA-v0WOdwaIUoefo8zvkWmzm1Z-dn-P\"/>\n<div>\n<div className=\"flex items-baseline gap-xs mb-xs\">\n<h4 className=\"font-label-md text-label-md text-on-surface\">AquaTech Team</h4>\n<span className=\"text-xs text-outline font-body-md\">2 hours ago</span>\n</div>\n<p className=\"font-body-md text-body-md text-on-surface-variant\">Sensors installed at main reservoir. Initial telemetry data indicates nominal pressure levels. We will monitor for the next 48 hours to establish a baseline.</p>\n<div className=\"mt-sm flex gap-sm\">\n<div className=\"h-24 w-32 rounded bg-surface-variant overflow-hidden\">\n<img className=\"w-full h-full object-cover\" data-alt=\"A close up, detailed photograph of industrial water pipes and a digital pressure sensor installed in a clean utility room. The lighting is artificial and slightly cool, highlighting the metallic textures of the pipes and the digital display of the sensor. The aesthetic is industrial yet highly technical and precise.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDbLhwbjOQRBCfVhuN8b6ucNjJ6I8yfgw0yNxvkHJebjJS4RvzUa_6rFeTS5qq_txCCLBwuE5s0Rhx3VsvY8iXdJCzxFaaZDXsUsovYOlI7DE-OuqKMM-V-q32pvXkjf6SLSqU8qJtzWTUMMIZVsBnM_iNbqOpPFrXPjF-47jHPkFIx6yPaXpniiS2EDu_zRdRQX_E-e3nQe3l3W76zM74BypmNVJn5LdQKp0RCrazdVi1y32Q2SZnQopoLSVBotKWmzmWJlO4y1SjN\"/>\n</div>\n</div>\n</div>\n</article>\n{/* Feed Item 2 */}\n<article className=\"flex gap-sm pb-md border-b border-surface-variant last:border-0 last:pb-0\">\n<div className=\"w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-label-md font-bold shrink-0\">\n                                TS\n                            </div>\n<div>\n<div className=\"flex items-baseline gap-xs mb-xs\">\n<h4 className=\"font-label-md text-label-md text-on-surface\">Tata Steel Liaison</h4>\n<span className=\"text-xs text-outline font-body-md\">1 day ago</span>\n</div>\n<p className=\"font-body-md text-body-md text-on-surface-variant\">Equipment for Phase 2 has cleared inspection and is cleared for deployment. Logistics team is coordinating with the local municipality for access tomorrow morning.</p>\n</div>\n</article>\n</div>\n</section>\n</div>\n{/* Right Column (30%) */}\n<div className=\"lg:col-span-4 flex flex-col gap-lg\">\n{/* Project Team Section */}\n<section className=\"bg-surface-container-lowest rounded-lg p-md shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant\">\n<h2 className=\"font-headline-md text-headline-md text-on-surface mb-md flex items-center gap-xs\">\n<span className=\"material-symbols-outlined text-primary\">groups</span>\n                        Project Team\n                    </h2>\n<div className=\"space-y-sm\">\n{/* Citizen Reporter */}\n<div className=\"flex items-center gap-sm p-sm rounded-lg hover:bg-surface-container-low transition-colors border border-transparent hover:border-surface-variant cursor-pointer\">\n<img className=\"w-12 h-12 rounded-full object-cover bg-surface-variant\" data-alt=\"A candid, warm portrait of a local community member standing outdoors in a bright, sunlit environment. The background shows a modern civic space slightly out of focus. The mood is trustworthy and optimistic. The lighting is natural and flattering.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBJn8zPeVnyjtHvIq5SkVpIdqK-u3DtW0v_zsBGo2bqJj0MibX93TVs1GxV_2oTo-h4llfh8VgX3NBloPm70yDEvgs0s6QMIY94Kay46r7brDzuC6MqAdnzt-MyjwV6JhwkvkLcuUOicJpJQKqmpf-me2YAqKLOekTTJD-3Dhyuf6p5MUgV1tTh7RlUUsKhUo08mvozJlCJBbKQKh9FsbAOd-NsRvxdSDGE4yiGvIHfn28Rqs4ITaQA5C-Bc-GzULXUG4WuS63q9BJx\"/>\n<div className=\"flex-1\">\n<h3 className=\"font-label-md text-label-md text-on-surface\">A. Kumar</h3>\n<p className=\"text-xs font-label-sm text-primary uppercase tracking-wider\">Citizen Reporter</p>\n</div>\n<button className=\"text-outline hover:text-primary transition-colors p-xs\">\n<span className=\"material-symbols-outlined text-sm\">mail</span>\n</button>\n</div>\n{/* University Team */}\n<div className=\"flex items-center gap-sm p-sm rounded-lg hover:bg-surface-container-low transition-colors border border-transparent hover:border-surface-variant cursor-pointer\">\n<div className=\"w-12 h-12 rounded-lg bg-surface-variant flex items-center justify-center text-outline overflow-hidden\">\n<img className=\"w-full h-full object-cover\" data-alt=\"A clean, modern logo featuring an abstract representation of water and technology, utilizing sharp geometric shapes. The logo is presented on a stark white background. The colors used are deep primary blue and a subtle cyan accent. The overall look is academic yet highly professional.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAYc9V3kH881HhBnldxHIwM0g_cBgaiubxVns9EP4xtuTT7KFFlXaBj2lVIHdphhkIWbEjQoZtdwFgsIpUBW_6uLys67Nve2TJy96wpR467Lb-srVgX2n_vMsxvKIJAfTFenqsy98sH1Lt3ZpJxByJpjQev0q4E8mfMWGotcv81GR-GtDOeFNV3O2nCnloW8hTvafejiXJBFCffr_XyXspE2NkjEFeXkwRuAtD_kN0sCyXEnckhSkv3OQ8Jo-9M5KQp2GEeAGuzbm8l\"/>\n</div>\n<div className=\"flex-1\">\n<h3 className=\"font-label-md text-label-md text-on-surface\">AquaTech Innovators</h3>\n<p className=\"text-xs font-label-sm text-secondary uppercase tracking-wider\">BIT Mesra Team</p>\n</div>\n<button className=\"text-outline hover:text-primary transition-colors p-xs\">\n<span className=\"material-symbols-outlined text-sm\">open_in_new</span>\n</button>\n</div>\n{/* Industry Sponsor */}\n<div className=\"flex items-center gap-sm p-sm rounded-lg hover:bg-surface-container-low transition-colors border border-transparent hover:border-surface-variant cursor-pointer\">\n<div className=\"w-12 h-12 rounded-lg bg-surface-variant flex items-center justify-center text-outline overflow-hidden\">\n<img className=\"w-full h-full object-cover p-1 bg-white\" data-alt=\"A crisp, high-resolution rendering of a corporate sponsor logo displayed against a minimal, light-mode background. The logo signifies industrial strength and reliability, utilizing bold, dark typography and a structured icon. The scene is brightly lit to emphasize transparency.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuChf4eWpTZTgQjU_0P0lLIz8PJnj1EGnXwKVnAcG8cMGHubPFIva5vodNufc4HO3VIBd4ywDtrGHDt-DyCCfxavgBhYQoHkm7lNyr68Keenc25-DfafHHEBZjnRT5pNn9xgSoceYAUwKFaXODO70jH46Mpad8ooDeTnLOPiA85sKoyG9JVHpj56SvV9baWbfgCRVpdY_a455Qz5VkeevREZXTknzDqn-3oEYExSFM1gPYOcSxTnpc1jzTVH6WwvpipHUK8QW-nxuLau\"/>\n</div>\n<div className=\"flex-1\">\n<h3 className=\"font-label-md text-label-md text-on-surface\">Tata Steel</h3>\n<p className=\"text-xs font-label-sm text-on-surface-variant uppercase tracking-wider\">Industry Sponsor</p>\n</div>\n</div>\n</div>\n<button className=\"w-full mt-md py-sm border border-outline-variant text-primary rounded-lg font-label-md text-label-md hover:bg-primary-fixed/30 transition-colors\">\n                        View All Contributors\n                    </button>\n</section>\n{/* Data Summary Widget (Example of Data Viz Layer) */}\n<section className=\"bg-data-viz-bg rounded-lg p-md shadow-lg border border-[#374151]\">\n<h2 className=\"font-headline-md text-headline-md text-on-primary mb-sm flex items-center gap-xs\">\n<span className=\"material-symbols-outlined text-inverse-primary\">analytics</span>\n                        Project Metrics\n                    </h2>\n<div className=\"grid grid-cols-2 gap-sm mb-md\">\n<div className=\"bg-[#374151] rounded p-sm border border-[#4B5563]\">\n<p className=\"text-xs text-outline-variant uppercase tracking-wider mb-xs\">Sensors Active</p>\n<p className=\"font-display-lg-mobile text-inverse-primary\">12<span className=\"text-sm text-outline-variant font-body-md ml-1\">/ 20</span></p>\n</div>\n<div className=\"bg-[#374151] rounded p-sm border border-[#4B5563]\">\n<p className=\"text-xs text-outline-variant uppercase tracking-wider mb-xs\">Data Points</p>\n... (truncated)\n```\n\n--- /src/app/researcher/page.tsx ---\n```typescript\n\'use client\';\n\nimport { useState } from \'react\';\nimport { mockChallenges, mockProposals, mockLeaderboard, Category } from \'@/lib/data\';\nimport ChallengeCard from \'@/components/ChallengeCard\';\nimport { Search, Trophy, Filter, Send } from \'lucide-react\';\n\nconst categories: Category[] = [\'Education\', \'Healthcare\', \'Agriculture\', \'Water Management\', \'Environment\', \'Public Service\', \'Mining Safety\', \'Tribal Welfare\'];\n\nexport default function ResearcherPortal() {\n  const [tab, setTab] = useState<\'explore\' | \'proposals\' | \'leaderboard\'>(\'explore\');\n  const [filterCat, setFilterCat] = useState<string>(\'\');\n  const [search, setSearch] = useState(\'\');\n\n  const openChallenges = mockChallenges.filter(c =>\n    c.status === \'Open for Proposals\' || c.status === \'Validated\'\n  );\n\n  const filtered = openChallenges.filter(c =>\n    (!filterCat || c.category === filterCat) &&\n    (!search || c.title.toLowerCase().includes(search.toLowerCase()) || c.description.toLowerCase().includes(search.toLowerCase()))\n  );\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\">\n      <div className=\"mb-8\">\n        <h1 className=\"text-3xl font-bold text-gray-900\">\360\237\216\223 Researcher / HEI Hub</h1>\n        <p className=\"text-gray-500 mt-1\">Explore challenges, submit proposals, and climb the leaderboard.</p>\n      </div>\n\n      {/* Tabs */}\n      <div className=\"flex space-x-1 bg-gray-100 rounded-xl p-1 mb-8 max-w-md\">\n        {([\'explore\', \'proposals\', \'leaderboard\'] as const).map(t => (\n          <button key={t} onClick={() => setTab(t)}\n            className={`flex-1 px-4 py-2 rounded-lg text-sm font-medium capitalize transition ${tab === t ? \'bg-white shadow text-blue-700\' : \'text-gray-500 hover:text-gray-700\'}`}\n          >{t === \'explore\' ? \'\360\237\224\215 Explore\' : t === \'proposals\' ? \'\360\237\223\204 My Proposals\' : \'\360\237\217\206 Leaderboard\'}</button>\n        ))}\n      </div>\n\n      {/* Explore Tab */}\n      {tab === \'explore\' && (\n        <div>\n          <div className=\"flex flex-col md:flex-row gap-4 mb-6\">\n            <div className=\"relative flex-1\">\n              <Search className=\"absolute left-3 top-2.5 w-5 h-5 text-gray-400\" />\n              <input\n                type=\"text\"\n                value={search}\n                onChange={(e) => setSearch(e.target.value)}\n                placeholder=\"Search challenges by keyword...\"\n                className=\"w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500\"\n              />\n            </div>\n            <select\n              value={filterCat}\n              onChange={(e) => setFilterCat(e.target.value)}\n              className=\"rounded-lg border border-gray-300 px-3 py-2 text-sm\"\n            >\n              <option value=\"\">All Categories</option>\n              {categories.map(c => <option key={c} value={c}>{c}</option>)}\n            </select>\n          </div>\n          <p className=\"text-sm text-gray-500 mb-4\">{filtered.length} challenges available for proposals</p>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {filtered.map(c => <ChallengeCard key={c.id} challenge={c} />)}\n          </div>\n          {filtered.length === 0 && (\n            <div className=\"text-center py-16 text-gray-400\">\n              <p className=\"text-xl\">\360\237\224\215</p>\n              <p>No challenges match your filters.</p>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Proposals Tab */}\n      {tab === \'proposals\' && (\n        <div className=\"space-y-4\">\n          <h2 className=\"text-xl font-bold text-gray-900\">My Submitted Proposals</h2>\n          {mockProposals.map(p => (\n            <div key={p.id} className=\"bg-white rounded-xl shadow-sm border p-5\">\n              <div className=\"flex justify-between items-start mb-2\">\n                <div>\n                  <h3 className=\"font-semibold text-gray-900\">{p.teamName}</h3>\n                  <p className=\"text-sm text-gray-500\">{p.institution}</p>\n                </div>\n                <span className={`px-3 py-1 rounded-full text-xs font-semibold ${\n                  p.status === \'Accepted\' ? \'bg-green-100 text-green-700\' :\n                  p.status === \'Rejected\' ? \'bg-red-100 text-red-700\' :\n                  \'bg-yellow-100 text-yellow-800\'\n                }`}>{p.status}</span>\n              </div>\n              <p className=\"text-sm text-gray-600 mb-3\">{p.approach}</p>\n              <div className=\"flex flex-wrap gap-4 text-xs text-gray-500\">\n                <span>\342\217\261\357\270\217 Timeline: {p.timeline}</span>\n                <span>\360\237\222\260 Budget: {p.budgetRequest}</span>\n                <span>\342\255\220 Impact Score: {p.impactScore}</span>\n              </div>\n              <div className=\"mt-3 flex flex-wrap gap-1\">\n                {p.teamMembers.map(m => (\n                  <span key={m} className=\"text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full\">{m}</span>\n                ))}\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Leaderboard Tab */}\n      {tab === \'leaderboard\' && (\n        <div>\n          <h2 className=\"text-xl font-bold text-gray-900 mb-4 flex items-center\"><Trophy className=\"w-6 h-6 mr-2 text-yellow-500\" /> Impact Leaderboard</h2>\n          <div className=\"bg-white rounded-xl shadow-sm border overflow-hidden\">\n            <table className=\"min-w-full divide-y divide-gray-200\">\n              <thead className=\"bg-gray-50\">\n                <tr>\n                  <th className=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase\">Rank</th>\n                  <th className=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase\">Researcher</th>\n                  <th className=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase\">Institution</th>\n                  <th className=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase\">Impact Score</th>\n                  <th className=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase\">Solved</th>\n                  <th className=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase\">Badge</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-gray-200\">\n                {mockLeaderboard.map(entry => (\n                  <tr key={entry.rank} className={entry.rank <= 3 ? \'bg-yellow-50/50\' : \'hover:bg-gray-50\'}>\n                    <td className=\"px-4 py-3 text-sm font-bold text-gray-900\">#{entry.rank}</td>\n                    <td className=\"px-4 py-3 text-sm font-medium text-gray-900\">{entry.name}</td>\n                    <td className=\"px-4 py-3 text-sm text-gray-500\">{entry.institution}</td>\n                    <td className=\"px-4 py-3\">\n                      <div className=\"flex items-center\">\n                        <div className=\"w-20 bg-gray-200 rounded-full h-2 mr-2\">\n                          <div className=\"h-2 rounded-full bg-gradient-to-r from-yellow-400 to-orange-500\" style={{ width: `${(entry.impactScore / 1000) * 100}%` }} />\n                        </div>\n                        <span className=\"text-sm font-bold text-gray-900\">{entry.impactScore}</span>\n                      </div>\n                    </td>\n                    <td className=\"px-4 py-3 text-sm text-gray-900\">{entry.challengesSolved}</td>\n                    <td className=\"px-4 py-3 text-sm\">{entry.badge}</td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2017\",\n    \"lib\": [\"dom\", \"dom.iterable\", \"esnext\"],\n    \"allowJs\": true,\n    \"skipLibCheck\": true,\n    \"strict\": true,\n    \"noEmit\": true,\n    \"esModuleInterop\": true,\n    \"module\": \"esnext\",\n    \"moduleResolution\": \"bundler\",\n    \"resolveJsonModule\": true,\n    \"isolatedModules\": true,\n    \"jsx\": \"react-jsx\",\n    \"incremental\": true,\n    \"plugins\": [\n      {\n        \"name\": \"next\"\n      }\n    ],\n    \"paths\": {\n      \"@/*\": [\"./src/*\"]\n    }\n  },\n  \"include\": [\n    \"next-env.d.ts\",\n    \"**/*.ts\",\n    \"**/*.tsx\",\n    \".next/types/**/*.ts\",\n    \".next/dev/types/**/*.ts\",\n    \"**/*.mts\"\n  ],\n  \"exclude\": [\"node_modules\"]\n}\n\n```"
    items {
      text: "Here is the full initial file tree for the application:\n/.gitignore\n/AGENTS.md\n/CLAUDE.md\n/README.md\n/eslint.config.mjs\n/next.config.ts\n/package.json\n/postcss.config.mjs\n/public/file.svg\n/public/globe.svg\n/public/next.svg\n/public/vercel.svg\n/public/window.svg\n/src/app/admin/page.tsx\n/src/app/challenges/[id]/page.tsx\n/src/app/challenges/page.tsx\n/src/app/citizen/page.tsx\n/src/app/favicon.ico\n/src/app/globals.css\n/src/app/industry/page.tsx\n/src/app/layout.tsx\n/src/app/page.tsx\n/src/app/project/[id]/page.tsx\n/src/app/researcher/page.tsx\n/src/components/ChallengeCard.tsx\n/src/components/Footer.tsx\n/src/components/Navbar.tsx\n/src/components/StatusBadge.tsx\n/src/lib/AppContext.tsx\n/src/lib/data.ts\n/tsconfig.json\n\nThe following dependencies are installed:\nlucide-react: ^0.470.0\nnext: 16.3.4\nreact: 19.2.8\nreact-dom: 19.2.8\nrecharts: ^2.15.0\n\nThe following devDependencies are installed:\n@tailwindcss/postcss: ^4\n@types/node: ^20\n@types/react: ^19\n@types/react-dom: ^19\neslint: ^9\neslint-config-next: 16.3.4\ntailwindcss: ^4\ntypescript: ^5\n\nKey file contents:\n\n--- /next.config.ts ---\n```typescript\nimport type { NextConfig } from \"next\";\n\nconst nextConfig: NextConfig = {\n  /* config options here */\n};\n\nexport default nextConfig;\n\n```\n\n--- /src/app/admin/page.tsx ---\n```typescript\nimport Link from \'next/link\';\n\nexport default function Page() {\n  return (\n    <div className=\"pt-16\">\n      \n{/* Header & Analytics */}\n<section className=\"flex flex-col gap-md\">\n<h1 className=\"font-headline-lg text-headline-lg text-on-background\">Admin Kanban Board</h1>\n<div className=\"grid grid-cols-1 md:grid-cols-3 gap-md\">\n{/* Analytics Card 1 */}\n<div className=\"bg-surface-container-lowest p-sm rounded-xl shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant flex flex-col gap-xs\">\n<div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-label-md\">\n<span className=\"material-symbols-outlined text-primary\" data-icon=\"assignment\">assignment</span>\n<span>Total Challenges</span>\n</div>\n<div className=\"font-display-lg text-display-lg text-on-surface\">1,240</div>\n</div>\n{/* Analytics Card 2 */}\n<div className=\"bg-surface-container-lowest p-sm rounded-xl shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant flex flex-col gap-xs\">\n<div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-label-md\">\n<span className=\"material-symbols-outlined text-secondary\" data-icon=\"work\">work</span>\n<span>Active Projects</span>\n</div>\n<div className=\"font-display-lg text-display-lg text-on-surface\">84</div>\n</div>\n{/* Analytics Card 3 */}\n<div className=\"bg-surface-container-lowest p-sm rounded-xl shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant flex flex-col gap-xs\">\n<div className=\"flex items-center gap-2 text-on-surface-variant font-label-md text-label-md\">\n<span className=\"material-symbols-outlined text-success-green\" data-icon=\"check_circle\">check_circle</span>\n<span>Success Rate</span>\n</div>\n<div className=\"font-display-lg text-display-lg text-success-green\">92%</div>\n</div>\n</div>\n</section>\n{/* Kanban Board */}\n<section className=\"flex-grow flex gap-md overflow-x-auto hide-scrollbar pb-md h-full min-h-[600px]\">\n{/* Column 1: Reported */}\n<div className=\"flex-shrink-0 w-80 flex flex-col gap-sm bg-surface-container-low rounded-xl p-sm\">\n<div className=\"flex items-center justify-between px-2 pb-2 border-b border-outline-variant\">\n<h2 className=\"font-label-md text-label-md text-on-surface uppercase tracking-wider\">Reported</h2>\n<span className=\"bg-surface-variant text-on-surface-variant rounded-full px-2 py-1 text-xs font-label-sm\">3</span>\n</div>\n<div className=\"flex flex-col gap-sm overflow-y-auto h-full pr-2\">\n{/* Card */}\n<div className=\"bg-surface-container-lowest p-sm rounded-lg shadow-sm border border-outline-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-shadow\">\n<div className=\"flex justify-between items-start\">\n<span className=\"bg-error-container text-on-error-container text-[10px] font-bold px-2 py-1 rounded\">HIGH URGENCY</span>\n<button className=\"text-outline hover:text-primary\"><span className=\"material-symbols-outlined text-sm\" data-icon=\"more_vert\">more_vert</span></button>\n</div>\n<h3 className=\"font-headline-md text-lg leading-tight text-on-surface mt-1\">Rural Electrification in Simdega</h3>\n<div className=\"flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm mt-2\">\n<span className=\"material-symbols-outlined text-xs\" data-icon=\"location_on\">location_on</span>\n<span>Simdega</span>\n</div>\n<div className=\"mt-2 pt-2 border-t border-outline-variant flex items-center gap-2\">\n<span className=\"material-symbols-outlined text-primary text-sm\" data-icon=\"smart_toy\">smart_toy</span>\n<span className=\"font-label-sm text-label-sm text-primary\">Matches: IIT ISM Dhanbad</span>\n</div>\n</div>\n{/* Card */}\n<div className=\"bg-surface-container-lowest p-sm rounded-lg shadow-sm border border-outline-variant flex flex-col gap-xs cursor-pointer hover:shadow-md transition-shadow\">\n<div className=\"flex justify-between items-start\">\n<span className=\"bg-surface-variant text-on-surface-variant text-[10px] font-bold px-2 py-1 rounded\">LOW URGENCY</span>\n<button className=\"text-outline hover:text-primary\"><span className=\"material-symbols-outlined text-sm\" data-icon=\"more_vert\">more_vert</span></button>\n</div>\n<h3 className=\"font-headline-md text-lg leading-tight text-on-surface mt-1\">Water Quality Monitoring</h3>\n<div className=\"flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm mt-2\">\n<span className=\"material-symbols-outlined text-xs\" data-icon=\"location_on\">location_on</span>\n<span>Dhanbad</span>\n</div>\n<div className=\"mt-2 pt-2 border-t b