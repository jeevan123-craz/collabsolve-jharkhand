}} transition={{ duration: 0.8, ease: \"easeOut\", delay: 0.7 }} className=\"w-full bg-[#FBBF24]/60 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n              <motion.div initial={{ height: 0 }} whileInView={{ height: \'20%\' }} transition={{ duration: 0.8, ease: \"easeOut\", delay: 0.75 }} className=\"w-full bg-[#FBBF24]/60 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n              <motion.div initial={{ height: 0 }} whileInView={{ height: \'18%\' }} transition={{ duration: 0.8, ease: \"easeOut\", delay: 0.8 }} className=\"w-full bg-[#FBBF24]/50 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n              <motion.div initial={{ height: 0 }} whileInView={{ height: \'15%\' }} transition={{ duration: 0.8, ease: \"easeOut\", delay: 0.85 }} className=\"w-full bg-[#FBBF24]/50 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n              <motion.div initial={{ height: 0 }} whileInView={{ height: \'12%\' }} transition={{ duration: 0.8, ease: \"easeOut\", delay: 0.9 }} className=\"w-full bg-[#FBBF24]/40 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n              <motion.div initial={{ height: 0 }} whileInView={{ height: \'10%\' }} transition={{ duration: 0.8, ease: \"easeOut\", delay: 0.95 }} className=\"w-full bg-[#FBBF24]/40 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n              <motion.div initial={{ height: 0 }} whileInView={{ height: \'8%\' }} transition={{ duration: 0.8, ease: \"easeOut\", delay: 1.0 }} className=\"w-full bg-[#FBBF24]/30 rounded-t-sm chart-bar relative group hover:bg-[#FBBF24] transition-colors\"></motion.div>\n              <motion.div initial={{ height: 0 }} whileInView={{ height: \'7%\' }} transition={{ duration: 0.8, ease: \"easeOut\", delay: 1.05 }} className=\"w-full bg-