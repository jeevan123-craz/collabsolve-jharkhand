/framework/handlers/applyedit/apply_edit.go:118\n  | google3/third_party/gemini_coder/framework/handlers/handlers.(*FileChangeHandler).handleEdit\n  | \tthird_party/gemini_coder/framework/handlers/file_change.go:214\n  | google3/third_party/gemini_coder/framework/handlers/handlers.(*FileChangeHandler).Handle\n  | \tthird_party/gemini_coder/framework/handlers/file_change.go:84\n  | google3/third_party/gemini_coder/framework/executor/executor.(*Executor).handleStep\n  | \tthird_party/gemini_coder/framework/executor/executor.go:264\n  | google3/devtools/jetski/boq/agent_service/agent.NewStepMetricsDecorator.func1.1\n  | \tdevtools/jetski/boq/agent_service/step_metrics_decorator.go:25\n  | google3/third_party/gemini_coder/framework/executor/executor.(*ExecutionTrajectory).asyncHandleStep.func3\n  | \tthird_party/gemini_coder/framework/executor/execution_trajectory.go:333\n  | google3/go/context/detach.Go.func1\n  | \tgo/context/detach.go:250\n  | runtime.goexit\n  | \tthird_party/go/gc/src/runtime/asm_arm64.s:1039\n          \342\224\224\342\224\200 Wraps: (8) target content cannot be empty\nError types: (1) *withstack.withStack (2) *errutil.withPrefix (3) *withstack.withStack (4) *join.joinError (5) *withstack.withStack (6) *errutil.withPrefix (7) *withstack.withStack (8) *errutil.leafError"
