    instruction: "Update industry page to match the material design theme and add motion animations."
    replacement_infos {
      original_chunk {
        target_content: "\'use client\';\n\nimport { mockProposals, mockChallenges } from \'@/lib/data\';\nimport { Briefcase, DollarSign, TrendingUp, Users } from \'lucide-react\';\n\nexport default function IndustryPortal() {\n  const acceptedProposals = mockProposals.filter(p => p.status === \'Accepted\');\n  const totalBudget = acceptedProposals.reduce((sum, p) => {\n    const num = parseInt(p.budgetRequest.replace(/[^0-9]/g, \'\'));\n    return sum + (isNaN(num) ? 0 : num);\n  }, 0);\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\">\n      <div className=\"mb-8\">\n        <h1 className=\"text-3xl font-bold text-gray-900\">\360\237\217\255 Industry Partner Portal</h1>\n        <p className=\"text-gray-500 mt-1\">Fund, mentor, and power innovation-driven solutions for Jharkhand.</p>\n      </div>\n\n      {/* Stats */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-4 gap-4 mb-8\">\n        <div className=\"bg-white rounded-xl shadow-sm border p-5 text-center\">\n          <Briefcase className=\"w-8 h-8 mx-auto mb-2 text-purple-600\" />\n          <p className=\"text-2xl font-bold text-gray-900\">{acceptedProposals.length}</p>\n          <p className=\"text-xs text-gray-500\">Approved Proposals</p>\n        </div>\n        <div className=\"bg-white rounded-xl shadow-sm border p-5 text-center\">\n          <DollarSign className=\"w-8 h-8 mx-auto mb-2 text-green-600\" />\n          <p className=\"text-2xl font-bold text-gray-900\">\342\202\271{(totalBudget / 100).toFixed(0)}L</p>\n          <p className=\"text-xs text-gray-500\">Total Funding Needed</p>\n        </div>\n        <div className=\"bg-white rounded-xl shadow-sm border p-5 text-center\">\n          <Users className=\"w-8 h-8 mx-auto mb-2 text-blue-600\" />\n          <p className=\"text-2xl font-bold text-gray-900\">14</p>\n          <p className=\"text-xs text-gray-500\">Active Partners</p>\n        </div>\n        <div className=\"bg-white rounded-xl shadow-sm border p-5 text-center\">\n          <TrendingUp className=\"w-8 h-8 mx-auto mb-2 text-orange-600\" />\n          <p className=\"text-2xl font-bold text-gray-900\">89%</p>\n          <p className=\"text-xs text-gray-500\">Success Rate</p>\n        </div>\n      </div>\n\n      {/* Proposals Ready for Funding */}\n      <h2 className=\"text-xl font-bold text-gray-900 mb-4\">Proposals Ready for Sponsorship</h2>\n      <div className=\"space-y-4\">\n        {acceptedProposals.map(p => {\n          const challenge = mockChallenges.find(c => c.id === p.challengeId);\n          return (\n            <div key={p.id} className=\"bg-white rounded-xl shadow-sm border overflow-hidden\">\n              <div className=\"p-6\">\n                <div className=\"flex flex-col md:flex-row md:justify-between md:items-start gap-4\">\n                  <div className=\"flex-1\">\n                    <p className=\"text-xs text-gray-400 mb-1\">SOLVING: {challenge?.title || \'Unknown Challenge\'}</p>\n                    <h3 className=\"text-lg font-bold text-gray-900\">{p.teamName}</h3>\n                    <p className=\"text-sm text-blue-600 font-medium\">{p.institution}</p>\n                    <p className=\"text-sm text-gray-600 mt-3\">{p.approach}</p>\n                    <div className=\"flex flex-wrap gap-4 mt-4 text-sm text-gray-500\">\n                      <span>\342\217\261\357\270\217 {p.timeline}</span>\n                      <span>\360\237\222\260 {p.budgetRequest}</span>\n                      <span>\342\255\220 Impact: {p.impactScore}/100</span>\n                    </div>\n                    <div className=\"mt-3 flex flex-wrap gap-1\">\n                      {p.teamMembers.map(m => (\n                        <span key={m} className=\"text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full\">{m}</span>\n                      ))}\n                    </div>\n                  </div>\n                  <div className=\"flex flex-col gap-2\">\n                    <button className=\"bg-purple-600 text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-purple-700 transition\">\360\237\222\274 Sponsor This</button>\n                    <button className=\"border border-purple-600 text-purple-600 px-5 py-2 rounded-full text-sm font-semibold hover:bg-purple-50 transition\">\360\237\244\235 Offer Mentorship</button>\n                  </div>\n                </div>\n              </div>\n              {/* AI Match Tag */}\n              {challenge && (\n                <div className=\"bg-indigo-50 px-6 py-3 border-t\">\n                  <p className=\"text-xs font-semibold text-indigo-700\">\360\237\247\240 AI Match Confidence: 94% \342\200\224 This proposal strongly aligns with {challenge.category} expertise</p>\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n\n      {/* CSR Impact Tracker */}\n      <div className=\"mt-12 bg-gradient-to-br from-purple-700 to-indigo-800 rounded-2xl p-8 text-white\">\n        <h2 className=\"text-2xl font-bold mb-4\">\360\237\223\212 Your CSR Impact Dashboard</h2>\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          <div className=\"bg-white/10 rounded-xl p-5 backdrop-blur\">\n            <p className=\"text-3xl font-bold\">\342\202\27145L</p>\n            <p className=\"text-purple-200 text-sm\">Total CSR Investment</p>\n          </div>\n          <div className=\"bg-white/10 rounded-xl p-5 backdrop-blur\">\n            <p className=\"text-3xl font-bold\">12,000+</p>\n            <p className=\"text-purple-200 text-sm\">Lives Impacted</p>\n          </div>\n          <div className=\"bg-white/10 rounded-xl p-5 backdrop-blur\">\n            <p className=\"text-3xl font-bold\">5</p>\n            <p className=\"text-purple-200 text-sm\">Districts Covered</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}"
        replacement_content: "\'use client\';\n\nimport { motion } from \'motion/react\';\nimport { mockProposals, mockChallenges } from \'@/lib/data\';\nimport { Briefcase, DollarSign, TrendingUp, Users, Handshake } from \'lucide-react\';\n\nexport default function IndustryPortal() {\n  const acceptedProposals = mockProposals.filter(p => p.status === \'Accepted\');\n  const totalBudget = acceptedProposals.reduce((sum, p) => {\n    const num = parseInt(p.budgetRequest.replace(/[^0-9]/g, \'\'));\n    return sum + (isNaN(num) ? 0 : num);\n  }, 0);\n\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    visible: { opacity: 1, transition: { staggerChildren: 0.1 } }\n  };\n\n  const itemVariants = {\n    hidden: { y: 20, opacity: 0 },\n    visible: { y: 0, opacity: 1 }\n  };\n\n  return (\n    <div className=\"pt-8 px-gutter max-w-container-max mx-auto pb-xl\">\n      <motion.div initial=\"hidden\" animate=\"visible\" variants={containerVariants}>\n        \n        <motion.div variants={itemVariants} className=\"mb-8\">\n          <h1 className=\"font-headline-lg text-headline-lg text-on-surface mb-xs flex items-center gap-2\">\n            \360\237\217\255 Industry Partner Portal\n          </h1>\n          <p className=\"text-on-surface-variant text-body-lg\">Fund, mentor, and power innovation-driven solutions for Jharkhand\'s civic challenges.</p>\n        </motion.div>\n\n        {/* Stats */}\n        <motion.div variants={itemVariants} className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-md mb-xl\">\n          <div className=\"bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-variant p-6 text-center hover:shadow-md transition-shadow\">\n            <div className=\"w-12 h-12 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center mx-auto mb-3\">\n              <Briefcase className=\"w-6 h-6\" />\n            </div>\n            <p className=\"font-headline-md text-3xl font-bold text-on-surface\">{acceptedProposals.length}</p>\n            <p className=\"font-label-md text-sm text-on-surface-variant mt-1\">Approved Proposals</p>\n          </div>\n          <div className=\"bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-variant p-6 text-center hover:shadow-md transition-shadow\">\n            <div className=\"w-12 h-12 rounded-full bg-[#DCFCE7] text-success-green flex items-center justify-center mx-auto mb-3\">\n              <DollarSign className=\"w-6 h-6\" />\n            </div>\n            <p className=\"font-headline-md text-3xl font-bold text-on-surface\">\342\202\271{(totalBudget / 100).toFixed(0)}L</p>\n            <p className=\"font-label-md text-sm text-on-surface-variant mt-1\">Total Funding Needed</p>\n          </div>\n          <div className=\"bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-variant p-6 text-center hover:shadow-md transition-shadow\">\n            <div className=\"w-12 h-12 rounded-full bg-[#E0E7FF] text-[#4F46E5] flex items-center justify-center mx-auto mb-3\">\n              <Users className=\"w-6 h-6\" />\n            </div>\n            <p className=\"font-headline-md text-3xl font-bold text-on-surface\">14</p>\n            <p className=\"font-label-md text-sm text-on-surface-variant mt-1\">Active Partners</p>\n          </div>\n          <div className=\"bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-variant p-6 text-center hover:shadow-md transition-shadow\">\n            <div className=\"w-12 h-12 rounded-full bg-[#FFEDD5] text-warning-amber flex items-center justify-center mx-auto mb-3\">\n              <TrendingUp className=\"w-6 h-6\" />\n            </div>\n            <p className=\"font-headline-md text-3xl font-bold text-on-surface\">89%</p>\n            <p className=\"font-label-md text-sm text-on-surface-variant mt-1\">Implementation Success</p>\n          </div>\n        </motion.div>\n\n        {/* Proposals Ready for Funding */}\n        <motion.div variants={itemVariants} className=\"mb-4 flex items-center justify-between\">\n          <h2 className=\"font-headline-md text-headline-md text-on-surface\">Proposals Ready for Sponsorship</h2>\n        </motion.div>\n        \n        <motion.div variants={itemVariants} className=\"space-y-6\">\n          {acceptedProposals.map((p, idx) => {\n            const challenge = mockChallenges.find(c => c.id === p.challengeId);\n            return (\n              <motion.div \n                key={p.id} \n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ delay: 0.1 * idx }}\n                className=\"bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-variant overflow-hidden hover:shadow-md transition-all group\"\n              >\n                <div className=\"p-6 md:p-8\">\n                  <div className=\"flex flex-col md:flex-row md:justify-between md:items-start gap-6\">\n                    <div className=\"flex-1\">\n                      <p className=\"font-label-sm text-xs font-bold text-primary uppercase tracking-wider mb-2\">\n                        SOLVING: {challenge?.title || \'Unknown Challenge\'}\n                      </p>\n                      <h3 className=\"font-headline-md text-2xl font-bold text-on-surface\">{p.teamName}</h3>\n                      <p className=\"font-label-md text-sm text-on-surface-variant mt-1\">{p.institution}</p>\n                      \n                      <div className=\"bg-surface-container-low p-4 rounded-xl mt-4 border border-outline-variant/30\">\n                        <p className=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">{p.approach}</p>\n                      </div>\n                      \n                      <div className=\"flex flex-wrap gap-x-6 gap-y-3 mt-5 font-label-md text-sm text-on-surface\">\n                        <span className=\"flex items-center gap-1.5\"><span className=\"material-symbols-outlined text-outline\">schedule</span> {p.timeline}</span>\n                        <span className=\"flex items-center gap-1.5\"><span className=\"material-symbols-outlined text-success-green\">payments</span> {p.budgetRequest}</span>\n                        <span className=\"flex items-center gap-1.5\"><span className=\"material-symbols-outlined text-warning-amber\">star</span> Impact: {p.impactScore}/100</span>\n                      </div>\n                      \n                      <div className=\"mt-5 flex flex-wrap gap-2\">\n                        {p.teamMembers.map(m => (\n                          <span key={m} className=\"font-label-sm text-xs bg-surface-variant/50 text-on-surface-variant px-3 py-1 rounded-md\">{m}</span>\n                        ))}\n                      </div>\n                    </div>\n                    <div className=\"flex flex-col gap-3 min-w-[160px]\">\n                      <button className=\"bg-primary text-on-primary w-full px-5 py-2.5 rounded-xl font-label-md text-sm hover:bg-primary/90 transition-all shadow-sm active:scale-95 flex justify-center items-center gap-2\">\n                        <DollarSign className=\"w-4 h-4\" /> Sponsor\n                      </button>\n                      <button className=\"bg-transparent border border-primary text-primary w-full px-5 py-2.5 rounded-xl font-label-md text-sm hover:bg-primary/5 transition-all active:scale-95 flex justify-center items-center gap-2\">\n                        <Handshake className=\"w-4 h-4\" /> Mentor\n                      </button>\n                    </div>\n                  </div>\n                </div>\n                {/* AI Match Tag */}\n                {challenge && (\n                  <div className=\"bg-primary/5 px-6 md:px-8 py-3 border-t border-primary/10 flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-primary text-[20px]\">smart_toy</span>\n                    <p className=\"font-label-sm text-sm text-primary\">\n                      <strong>AI Match (94%):</strong> Strong alignment with your organization\'s focus on {challenge.category}\n                    </p>\n                  </div>\n                )}\n              </motion.div>\n            );\n          })}\n        </motion.div>\n\n        {/* CSR Impact Tracker */}\n        <motion.div variants={itemVariants} className=\"mt-xl bg-surface-container-highest rounded-3xl p-8 border border-outline-variant/50 relative overflow-hidden\">\n          <div className=\"absolute inset-0 bg-primary/5 pointer-events-none\"></div>\n          <div className=\"relative z-10\">\n            <h2 className=\"font-headline-md text-headline-md text-on-surface mb-6\">\360\237\223\212 Your CSR Impact Dashboard</h2>\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n              <div className=\"bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/30 flex flex-col items-center justify-center text-center\">\n                <p className=\"font-headline-lg text-4xl font-bold text-primary mb-1\">\342\202\27145L</p>\n                <p className=\"font-label-md text-sm text-on-surface-variant\">Total CSR Investment</p>\n              </div>\n              <div className=\"bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/30 flex flex-col items-center justify-center text-center\">\n                <p className=\"font-headline-lg text-4xl font-bold text-success-green mb-1\">12,000+</p>\n                <p className=\"font-label-md text-sm text-on-surface-variant\">Lives Impacted</p>\n              </div>\n              <div className=\"bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/30 flex flex-col items-center justify-center text-center\">\n                <p className=\"font-headline-lg text-4xl font-bold text-secondary mb-1\">5</p>\n                <p className=\"font-label-md text-sm text-on-surface-variant\">Districts Covered</p>\n              </div>\n            </div>\n          </div>\n        </motion.div>\n\n      </motion.div>\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
