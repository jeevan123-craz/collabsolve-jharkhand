    replacement_infos {
      original_chunk {
        target_content: "\'use client\';\n\nimport Link from \'next/link\';\nimport { motion } from \'motion/react\';\nimport { MapPin, AlertTriangle, Clock, ThumbsUp, Send } from \'lucide-react\';\n\nexport default function Page() {\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    visible: { opacity: 1, transition: { staggerChildren: 0.1 } }\n  };\n\n  const itemVariants = {\n    hidden: { y: 20, opacity: 0 },\n    visible: { y: 0, opacity: 1 }\n  };\n\n  return (\n    <div className=\"pt-8 px-gutter max-w-container-max mx-auto pb-xl\">\n      <motion.div \n        className=\"flex flex-col md:flex-row gap-lg\"\n        initial=\"hidden\"\n        animate=\"visible\"\n        variants={containerVariants}\n      >\n        {/* Left Side (60%): Report a Challenge Form */}\n        <motion.section variants={itemVariants} className=\"w-full md:w-3/5 flex flex-col gap-md\">\n          <div className=\"mb-sm\">\n            <h1 className=\"font-headline-lg text-headline-lg text-on-surface mb-xs\">Report a Challenge</h1>\n            <p className=\"text-on-surface-variant text-body-lg\">Submit detailed information about local issues to mobilize community solvers and state resources.</p>\n          </div>\n          \n          <div className=\"bg-surface-container-lowest p-md rounded-2xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant flex flex-col gap-md\">\n            <div className=\"flex flex-col gap-xs\">\n              <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"title\">Title</label>\n              <input className=\"px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface placeholder:text-outline bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full outline-none\" id=\"title\" placeholder=\"Brief, descriptive title of the issue\" type=\"text\" />\n            </div>\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-md\">\n              <div className=\"flex flex-col gap-xs\">\n                <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"category\">Category</label>\n                <div className=\"relative\">\n                  <select className=\"appearance-none px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full pr-10 outline-none\" id=\"category\" defaultValue=\"\">\n                    <option disabled value=\"\">Select Category</option>\n                    <option value=\"infrastructure\">Infrastructure & Roads</option>\n                    <option value=\"water\">Water & Sanitation</option>\n                    <option value=\"agriculture\">Agriculture & Farming</option>\n                    <option value=\"education\">Education</option>\n                    <option value=\"health\">Public Health</option>\n                  </select>\n                  <span className=\"material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none\">expand_more</span>\n                </div>\n              </div>\n              \n              <div className=\"flex flex-col gap-xs\">\n                <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"district\">District</label>\n                <div className=\"relative\">\n                  <select className=\"appearance-none px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full pr-10 outline-none\" id=\"district\" defaultValue=\"\">\n                    <option disabled value=\"\">Select District</option>\n                    <option value=\"ranchi\">Ranchi</option>\n                    <option value=\"chatra\">Chatra</option>\n                    <option value=\"bokaro\">Bokaro</option>\n                    <option value=\"dhanbad\">Dhanbad</option>\n                    <option value=\"hazaribagh\">Hazaribagh</option>\n                  </select>\n                  <span className=\"material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none\">expand_more</span>\n                </div>\n              </div>\n            </div>\n            \n            <div className=\"flex flex-col gap-xs\">\n              <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"description\">Description</label>\n              <textarea className=\"px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface placeholder:text-outline bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full resize-y outline-none\" id=\"description\" placeholder=\"Provide detailed context, current impact, and location specifics...\" rows={5}></textarea>\n            </div>\n            \n            <div className=\"flex flex-col gap-xs\">\n              <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"skills\">Required Skills (Optional)</label>\n              <input className=\"px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface placeholder:text-outline bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full outline-none\" id=\"skills\" placeholder=\"e.g., Civil Engineering, Data Analysis, Field Work\" type=\"text\" />\n              <p className=\"font-label-sm text-label-sm text-on-surface-variant mt-1\">Suggest skills that would help solve this challenge.</p>\n            </div>\n            \n            <div className=\"mt-sm flex justify-end\">\n              <button className=\"bg-primary text-on-primary font-label-md text-label-md px-6 py-3 rounded-xl hover:bg-primary/90 transition-all shadow-sm hover:shadow-md flex items-center gap-2 active:scale-95\">\n                <Send className=\"w-5 h-5\" />\n                Submit Challenge\n              </button>\n            </div>\n          </div>\n        </motion.section>\n\n        {/* Right Side (40%): Trending Local Challenges Feed */}\n        <motion.aside variants={itemVariants} className=\"w-full md:w-2/5 flex flex-col gap-md h-auto md:h-[calc(100vh-120px)] mt-8 md:mt-0\">\n          <div className=\"flex justify-between items-center mb-xs\">\n            <h2 className=\"font-headline-md text-headline-md text-on-surface\">Trending Locally</h2>\n            <Link href=\"/challenges\" className=\"text-primary font-label-sm text-label-sm hover:underline flex items-center gap-1 bg-primary/10 px-3 py-1.5 rounded-full transition-colors hover:bg-primary/20\">\n              View Map <MapPin className=\"w-4 h-4\" />\n            </Link>\n          </div>\n          \n          {/* Feed Container */}\n          <div className=\"flex flex-col gap-sm overflow-y-auto custom-scrollbar pr-2 pb-sm\">\n            {/* Challenge Card 1 */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant hover:shadow-md transition-all group cursor-pointer\">\n              <div className=\"flex justify-between items-start mb-3\">\n                <span className=\"inline-flex items-center px-2.5 py-1 rounded-md bg-error-container text-on-error-container font-label-sm text-xs font-bold gap-1 uppercase tracking-wider\">\n                  <AlertTriangle className=\"w-3.5 h-3.5\" /> High Priority\n                </span>\n                <span className=\"text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1 bg-surface-variant/50 px-2.5 py-1 rounded-md\">\n                  <MapPin className=\"w-3.5 h-3.5\" /> Chatra\n                </span>\n              </div>\n              <h3 className=\"font-headline-md text-xl leading-tight font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors\">Groundwater Depletion in Chatra</h3>\n              <p className=\"text-on-surface-variant text-sm line-clamp-2 mb-4 leading-relaxed\">Severe drop in water table levels affecting local agriculture and daily water supply for over 500 households in the eastern block.</p>\n              <div className=\"flex justify-between items-center pt-4 border-t border-surface-variant/50\">\n                <div className=\"flex items-center gap-2\">\n                  <button className=\"flex items-center justify-center w-9 h-9 rounded-full bg-surface hover:bg-primary-container hover:text-on-primary-container transition-colors text-on-surface-variant\">\n                    <ThumbsUp className=\"w-4 h-4\" />\n                  </button>\n                  <span className=\"font-label-md text-label-md text-on-surface font-semibold\">245</span>\n                </div>\n                <span className=\"text-xs text-outline font-bold uppercase tracking-wider\">Water & Sanitation</span>\n              </div>\n            </motion.div>\n\n            {/* Challenge Card 2 */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant hover:shadow-md transition-all group cursor-pointer\">\n              <div className=\"flex justify-between items-start mb-3\">\n                <span className=\"inline-flex items-center px-2.5 py-1 rounded-md bg-warning-amber/10 text-warning-amber font-label-sm text-xs font-bold gap-1 uppercase tracking-wider\">\n                  <Clock className=\"w-3.5 h-3.5\" /> Medium Priority\n                </span>\n                <span className=\"text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1 bg-surface-variant/50 px-2.5 py-1 rounded-md\">\n                  <MapPin className=\"w-3.5 h-3.5\" /> Ranchi\n                </span>\n              </div>\n              <h3 className=\"font-headline-md text-xl leading-tight font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors\">Traffic Congestion at Main Road</h3>\n              <p className=\"text-on-surface-variant text-sm line-clamp-2 mb-4 leading-relaxed\">Daily bottleneck during peak hours causing severe delays and increasing localized air pollution levels significantly.</p>\n              <div className=\"flex justify-between items-center pt-4 border-t border-surface-variant/50\">\n                <div className=\"flex items-center gap-2\">\n                  <button className=\"flex items-center justify-center w-9 h-9 rounded-full bg-surface hover:bg-primary-container hover:text-on-primary-container transition-colors text-on-surface-variant\">\n                    <ThumbsUp className=\"w-4 h-4\" />\n                  </button>\n                  <span className=\"font-label-md text-label-md text-on-surface font-semibold\">182</span>\n                </div>\n                <span className=\"text-xs text-outline font-bold uppercase tracking-wider\">Infrastructure</span>\n              </div>\n            </motion.div>\n            \n            {/* Challenge Card 3 */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant hover:shadow-md transition-all group cursor-pointer\">\n              <div className=\"flex justify-between items-start mb-3\">\n                <span className=\"inline-flex items-center px-2.5 py-1 rounded-md bg-error-container text-on-error-container font-label-sm text-xs font-bold gap-1 uppercase tracking-wider\">\n                  <AlertTriangle className=\"w-3.5 h-3.5\" /> High Priority\n                </span>\n                <span className=\"text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1 bg-surface-variant/50 px-2.5 py-1 rounded-md\">\n                  <MapPin className=\"w-3.5 h-3.5\" /> Bokaro\n                </span>\n              </div>\n              <h3 className=\"font-headline-md text-xl leading-tight font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors\">Industrial Waste Dumping in River</h3>\n              <p className=\"text-on-surface-variant text-sm line-clamp-2 mb-4 leading-relaxed\">Unauthorized discharge of effluents is affecting aquatic life and threatening downstream water utility intakes.</p>\n              <div className=\"flex justify-between items-center pt-4 border-t border-surface-variant/50\">\n                <div className=\"flex items-center gap-2\">\n                  <button className=\"flex items-center justify-center w-9 h-9 rounded-full bg-surface hover:bg-primary-container hover:text-on-primary-container transition-colors text-on-surface-variant\">\n                    <ThumbsUp className=\"w-4 h-4\" />\n                  </button>\n                  <span className=\"font-label-md text-label-md text-on-surface font-semibold\">410</span>\n                </div>\n                <span className=\"text-xs text-outline font-bold uppercase tracking-wider\">Public Health</span>\n              </div>\n            </motion.div>\n          </div>\n        </motion.aside>\n      </motion.div>\n    </div>\n  );\n}\n"
        replacement_content: "\'use client\';\n\nimport Link from \'next/link\';\nimport { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { MapPin, AlertTriangle, Clock, ThumbsUp, Send, Loader2, Sparkles } from \'lucide-react\';\nimport { db } from \'@/lib/firebase\';\nimport { collection, addDoc, serverTimestamp } from \'firebase/firestore\';\nimport { useApp } from \'@/lib/AppContext\';\n\nexport default function Page() {\n  const { user, login } = useApp();\n  const [title, setTitle] = useState(\'\');\n  const [description, setDescription] = useState(\'\');\n  const [category, setCategory] = useState(\'\');\n  const [district, setDistrict] = useState(\'\');\n  const [urgency, setUrgency] = useState(\'Medium\');\n  \n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [isSuggesting, setIsSuggesting] = useState(false);\n  const [aiSuggestions, setAiSuggestions] = useState<string[]>([]);\n  const [success, setSuccess] = useState(false);\n\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    visible: { opacity: 1, transition: { staggerChildren: 0.1 } }\n  };\n\n  const itemVariants = {\n    hidden: { y: 20, opacity: 0 },\n    visible: { y: 0, opacity: 1 }\n  };\n\n  const handleSuggestCategories = async () => {\n    if (!title || !description) return;\n    setIsSuggesting(true);\n    try {\n      const res = await fetch(\'/api/ai/suggest-categories\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ title, description })\n      });\n      const data = await res.json();\n      if (data.suggestions) {\n        setAiSuggestions(data.suggestions);\n        if (data.suggestions.length > 0 && !category) {\n          setCategory(data.suggestions[0]);\n        }\n      }\n    } catch (e) {\n      console.error(e);\n    }\n    setIsSuggesting(false);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!user) {\n      alert(\"Please login first to submit a challenge.\");\n      login();\n      return;\n    }\n    setIsSubmitting(true);\n    try {\n      await addDoc(collection(db, \'challenges\'), {\n        title,\n        description,\n        category: category || (aiSuggestions[0] || \'General\'),\n        district,\n        urgency,\n        status: \'Reported\',\n        authorId: user.uid,\n        createdAt: serverTimestamp(),\n        upvotes: 0,\n        comments: 0,\n        aiCategories: aiSuggestions\n      });\n      setSuccess(true);\n      setTitle(\'\');\n      setDescription(\'\');\n      setCategory(\'\');\n      setDistrict(\'\');\n      setAiSuggestions([]);\n    } catch (error) {\n      console.error(\"Error submitting challenge:\", error);\n      alert(\"Failed to submit challenge.\");\n    }\n    setIsSubmitting(false);\n  };\n\n  return (\n    <div className=\"pt-8 px-gutter max-w-container-max mx-auto pb-xl\">\n      <motion.div \n        className=\"flex flex-col md:flex-row gap-lg\"\n        initial=\"hidden\"\n        animate=\"visible\"\n        variants={containerVariants}\n      >\n        {/* Left Side (60%): Report a Challenge Form */}\n        <motion.section variants={itemVariants} className=\"w-full md:w-3/5 flex flex-col gap-md\">\n          <div className=\"mb-sm\">\n            <h1 className=\"font-headline-lg text-headline-lg text-on-surface mb-xs\">Report a Challenge</h1>\n            <p className=\"text-on-surface-variant text-body-lg\">Submit detailed information about local issues to mobilize community solvers and state resources.</p>\n          </div>\n          \n          <form onSubmit={handleSubmit} className=\"bg-surface-container-lowest p-md rounded-2xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-surface-variant flex flex-col gap-md relative overflow-hidden\">\n            {success && (\n              <div className=\"absolute inset-0 bg-surface-container-lowest/90 backdrop-blur-sm z-10 flex flex-col items-center justify-center p-8 text-center\">\n                <div className=\"w-16 h-16 bg-success-green/20 rounded-full flex items-center justify-center mb-4\">\n                  <ThumbsUp className=\"w-8 h-8 text-success-green\" />\n                </div>\n                <h3 className=\"font-headline-md text-2xl font-bold text-on-surface mb-2\">Challenge Submitted!</h3>\n                <p className=\"text-on-surface-variant mb-6\">Your challenge has been successfully reported and is now visible to researchers and innovators.</p>\n                <button type=\"button\" onClick={() => setSuccess(false)} className=\"bg-primary text-on-primary px-6 py-2 rounded-full font-bold\">\n                  Submit Another\n                </button>\n              </div>\n            )}\n\n            <div className=\"flex flex-col gap-xs\">\n              <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"title\">Title <span className=\"text-error\">*</span></label>\n              <input required value={title} onChange={e => setTitle(e.target.value)} className=\"px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface placeholder:text-outline bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full outline-none\" id=\"title\" placeholder=\"Brief, descriptive title of the issue\" type=\"text\" />\n            </div>\n            \n            <div className=\"flex flex-col gap-xs\">\n              <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"description\">Description <span className=\"text-error\">*</span></label>\n              <textarea required value={description} onChange={e => setDescription(e.target.value)} onBlur={handleSuggestCategories} className=\"px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface placeholder:text-outline bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full resize-y outline-none\" id=\"description\" placeholder=\"Provide detailed context, current impact, and location specifics...\" rows={5}></textarea>\n              <div className=\"flex justify-end\">\n                <button type=\"button\" onClick={handleSuggestCategories} disabled={isSuggesting || !title || !description} className=\"text-xs font-bold text-primary flex items-center gap-1 hover:underline disabled:opacity-50\">\n                  {isSuggesting ? <Loader2 className=\"w-3 h-3 animate-spin\" /> : <Sparkles className=\"w-3 h-3\" />}\n                  Auto-suggest Category\n                </button>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-md\">\n              <div className=\"flex flex-col gap-xs\">\n                <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"category\">Category <span className=\"text-error\">*</span></label>\n                <div className=\"relative\">\n                  <select required value={category} onChange={e => setCategory(e.target.value)} className=\"appearance-none px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full pr-10 outline-none\" id=\"category\">\n                    <option disabled value=\"\">Select Category</option>\n                    {aiSuggestions.length > 0 && (\n                      <optgroup label=\"AI Suggestions\">\n                        {aiSuggestions.map(s => <option key={s} value={s}>{s}</option>)}\n                      </optgroup>\n                    )}\n                    <optgroup label=\"All Categories\">\n                      <option value=\"Education\">Education</option>\n                      <option value=\"Healthcare\">Healthcare</option>\n                      <option value=\"Agriculture\">Agriculture & Farming</option>\n                      <option value=\"Water Management\">Water & Sanitation</option>\n                      <option value=\"Environment\">Environment</option>\n                      <option value=\"Infrastructure\">Infrastructure</option>\n                      <option value=\"Public Service\">Public Service</option>\n                      <option value=\"Tribal Welfare\">Tribal Welfare</option>\n                    </optgroup>\n                  </select>\n                  <span className=\"material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none\">expand_more</span>\n                </div>\n              </div>\n              \n              <div className=\"flex flex-col gap-xs\">\n                <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"district\">District <span className=\"text-error\">*</span></label>\n                <div className=\"relative\">\n                  <select required value={district} onChange={e => setDistrict(e.target.value)} className=\"appearance-none px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full pr-10 outline-none\" id=\"district\">\n                    <option disabled value=\"\">Select District</option>\n                    <option value=\"Ranchi\">Ranchi</option>\n                    <option value=\"Chatra\">Chatra</option>\n                    <option value=\"Bokaro\">Bokaro</option>\n                    <option value=\"Dhanbad\">Dhanbad</option>\n                    <option value=\"Hazaribagh\">Hazaribagh</option>\n                    <option value=\"Simdega\">Simdega</option>\n                  </select>\n                  <span className=\"material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none\">expand_more</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-xs\">\n              <label className=\"font-label-md text-label-md text-on-surface font-medium\" htmlFor=\"urgency\">Urgency</label>\n              <div className=\"relative\">\n                  <select value={urgency} onChange={e => setUrgency(e.target.value)} className=\"appearance-none px-4 py-3 border border-outline-variant rounded-xl text-body-md text-on-surface bg-surface focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all w-full pr-10 outline-none\" id=\"urgency\">\n                    <option value=\"Low\">Low</option>\n                    <option value=\"Medium\">Medium</option>\n                    <option value=\"High\">High</option>\n                    <option value=\"Critical\">Critical</option>\n                  </select>\n                  <span className=\"material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none\">expand_more</span>\n              </div>\n            </div>\n            \n            <div className=\"mt-sm flex justify-end\">\n              <button disabled={isSubmitting} type=\"submit\" className=\"bg-primary text-on-primary font-label-md text-label-md px-6 py-3 rounded-xl hover:bg-primary/90 transition-all shadow-sm hover:shadow-md flex items-center gap-2 active:scale-95 disabled:opacity-70\">\n                {isSubmitting ? <Loader2 className=\"w-5 h-5 animate-spin\" /> : <Send className=\"w-5 h-5\" />}\n                {isSubmitting ? \'Submitting...\' : \'Submit Challenge\'}\n              </button>\n            </div>\n          </form>\n        </motion.section>\n\n        {/* Right Side (40%): Trending Local Challenges Feed */}\n        <motion.aside variants={itemVariants} className=\"w-full md:w-2/5 flex flex-col gap-md h-auto md:h-[calc(100vh-120px)] mt-8 md:mt-0\">\n          <div className=\"flex justify-between items-center mb-xs\">\n            <h2 className=\"font-headline-md text-headline-md text-on-surface\">Trending Locally</h2>\n            <Link href=\"/challenges\" className=\"text-primary font-label-sm text-label-sm hover:underline flex items-center gap-1 bg-primary/10 px-3 py-1.5 rounded-full transition-colors hover:bg-primary/20\">\n              View Map <MapPin className=\"w-4 h-4\" />\n            </Link>\n          </div>\n          \n          {/* Feed Container */}\n          <div className=\"flex flex-col gap-sm overflow-y-auto custom-scrollbar pr-2 pb-sm\">\n            {/* Challenge Card 1 */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant hover:shadow-md transition-all group cursor-pointer\">\n              <div className=\"flex justify-between items-start mb-3\">\n                <span className=\"inline-flex items-center px-2.5 py-1 rounded-md bg-error-container text-on-error-container font-label-sm text-xs font-bold gap-1 uppercase tracking-wider\">\n                  <AlertTriangle className=\"w-3.5 h-3.5\" /> High Priority\n                </span>\n                <span className=\"text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1 bg-surface-variant/50 px-2.5 py-1 rounded-md\">\n                  <MapPin className=\"w-3.5 h-3.5\" /> Chatra\n                </span>\n              </div>\n              <h3 className=\"font-headline-md text-xl leading-tight font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors\">Groundwater Depletion in Chatra</h3>\n              <p className=\"text-on-surface-variant text-sm line-clamp-2 mb-4 leading-relaxed\">Severe drop in water table levels affecting local agriculture and daily water supply for over 500 households in the eastern block.</p>\n              <div className=\"flex justify-between items-center pt-4 border-t border-surface-variant/50\">\n                <div className=\"flex items-center gap-2\">\n                  <button className=\"flex items-center justify-center w-9 h-9 rounded-full bg-surface hover:bg-primary-container hover:text-on-primary-container transition-colors text-on-surface-variant\">\n                    <ThumbsUp className=\"w-4 h-4\" />\n                  </button>\n                  <span className=\"font-label-md text-label-md text-on-surface font-semibold\">245</span>\n                </div>\n                <span className=\"text-xs text-outline font-bold uppercase tracking-wider\">Water & Sanitation</span>\n              </div>\n            </motion.div>\n\n            {/* Challenge Card 2 */}\n            <motion.div whileHover={{ y: -2 }} className=\"bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-surface-variant hover:shadow-md transition-all group cursor-pointer\">\n              <div className=\"flex justify-between items-start mb-3\">\n                <span className=\"inline-flex items-center px-2.5 py-1 rounded-md bg-warning-amber/10 text-warning-amber font-label-sm text-xs font-bold gap-1 uppercase tracking-wider\">\n                  <Clock className=\"w-3.5 h-3.5\" /> Medium Priority\n                </span>\n                <span className=\"text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1 bg-surface-variant/50 px-2.5 py-1 rounded-md\">\n                  <MapPin className=\"w-3.5 h-3.5\" /> Ranchi\n                </span>\n              </div>\n              <h3 className=\"font-headline-md text-xl leading-tight font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors\">Traffic Congestion at Main Road</h3>\n              <p className=\"text-on-surface-variant text-sm line-clamp-2 mb-4 leading-relaxed\">Daily bottleneck during peak hours causing severe delays and increasing localized air pollution levels significantly.</p>\n              <div className=\"flex justify-between items-center pt-4 border-t border-surface-variant/50\">\n                <div className=\"flex items-center gap-2\">\n                  <button className=\"flex items-center justify-center w-9 h-9 rounded-full bg-surface hover:bg-primary-container hover:text-on-primary-container transition-colors text-on-surface-variant\">\n                    <ThumbsUp className=\"w-4 h-4\" />\n                  </button>\n                  <span className=\"font-label-md text-label-md text-on-surface font-semibold\">182</span>\n                </div>\n                <span className=\"text-xs text-outline font-bold uppercase tracking-wider\">Infrastructure</span>\n              </div>\n            </motion.div>\n          </div>\n        </motion.aside>\n      </motion.div>\n    </div>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
